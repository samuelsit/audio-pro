# Valeurs de développement local uniquement (docker-compose). Ne jamais y mettre de secret réel.
# Un rôle PostgreSQL par usage (ADR-016). L'application se connecte en ha_app, soumis à la Row Level
# Security ; `pnpm db:roles` pose les mots de passe de ces URL. Propriétaire : migrations, seed, import LPP.
DATABASE_URL_ADMIN="postgresql://ha:ha@localhost:5433/ha_gestion?schema=public"
DATABASE_URL="postgresql://ha_app:ha_app@localhost:5433/ha_gestion?schema=public"
DATABASE_URL_PLATEFORME="postgresql://ha_plateforme:ha_plateforme@localhost:5433/ha_gestion?schema=public"
DATABASE_URL_JOBS="postgresql://ha_jobs:ha_jobs@localhost:5433/ha_gestion?schema=public"
# Connexions par client Prisma et par processus (10 par défaut), hors pg-boss.
# DATABASE_POOL_MAX=10
# Proxys de confiance devant l'application, pour lire l'adresse du client : entier d'au moins 1 (1 par
# défaut). Toute autre valeur fait échouer la connexion plutôt que d'ouvrir la limite de tentatives.
# PROXIES_DE_CONFIANCE=1

S3_ENDPOINT="http://localhost:9000"
S3_REGION="eu-west-3"
S3_ACCESS_KEY="ha-minio"
S3_SECRET_KEY="ha-minio-secret"
S3_BUCKET="ha-documents"
# « memoire » : documents en mémoire au lieu de S3 (tests d'intégration, jamais en production).
# DOCUMENTS_STOCKAGE="memoire"

# Signature des clôtures et des archives de caisse (ADR-029) : clé privée Ed25519, PKCS#8 DER en base64, hors de la
# base. Obligatoire en production ; simulée sinon. Après une rotation, garder les anciennes clés publiques.
# CAISSE_SIGNATURE_CLE_PRIVEE=""
# CAISSE_SIGNATURE_CLES_ANCIENNES=""

# Base dédiée aux tests d'intégration (vidée à chaque exécution).
DATABASE_URL_TEST="postgresql://ha:ha@localhost:5433/ha_gestion_test?schema=public"

# Authentification (Better Auth). En production : secret aléatoire d'au moins 32 caractères
# (openssl rand -base64 32), jamais versionné.
BETTER_AUTH_SECRET="dev-uniquement-a-remplacer-en-production-0123456789"
BETTER_AUTH_URL="http://localhost:3000"

# Mot de passe des comptes de démonstration créés par `pnpm db:seed` (dev uniquement).
SEED_MOT_DE_PASSE_DEMO="demo-ha-gestion-2026"

# Base dédiée aux tests E2E (vidée puis seedée à chaque exécution de Playwright).
DATABASE_URL_E2E="postgresql://ha:ha@localhost:5433/ha_gestion_e2e?schema=public"

# Chiffrement applicatif des champs sensibles (AES-256-GCM, voir ADR-005). Liste « identifiant:clé »
# (clé : openssl rand -base64 32) et identifiant de la clé active. Clé de développement uniquement :
# en production, clés propres à l'environnement, jamais versionnées.
CHIFFREMENT_CLES="dev2026:jcQ6EY4b3AA2xugTawghMYZia08m/ldjYOOeIJw8Fi8="
CHIFFREMENT_CLE_ACTIVE="dev2026"

# Clé des empreintes HMAC-SHA256 (recherche exacte et doublons sur le NIR chiffré, voir ADR-006).
# Distincte des clés de chiffrement (openssl rand -base64 32). Clé de développement uniquement.
EMPREINTE_CLE="m87UsslN9oc7aRwKUMNYHP0WYVexj9clLSjnI4tL4no="

# Lecteur de carte Vitale. « simulation » : lecteur simulé (fixtures/vitale) et sélecteur de la carte
# insérée, en développement uniquement (ignoré en production). Sans valeur : aucun lecteur (le lecteur
# réel AreaFSE arrive à l'étape 25). VITALE_FIXTURES remplace le dossier des cartes fictives.
VITALE_LECTEUR="simulation"

# Rendu PDF : "simulation" hors production ; PDF_CHROMIUM_CHEMIN désigne le binaire en production.
# PDF_RENDU=simulation
# PDF_CHROMIUM_CHEMIN=/usr/bin/chromium

# E-mails de développement : Mailpit (docker-compose), interface sur http://localhost:8025.
MAIL_SMTP_HOTE="localhost"
MAIL_SMTP_PORT="1025"

# Réservation en ligne (ADR-021).
# Adresse publique : liens envoyés aux patients et widget. Par défaut, BETTER_AUTH_URL.
URL_PUBLIQUE="http://localhost:3000"
# Clé du lien de gestion d'un rendez-vous (base64, 32 octets) : openssl rand -base64 32.
LIEN_RDV_CLE="yxr4c7cfqNnEeVQ2vmVfMCz6YjGqkH7aHq1Gg0mzqyI="
# Envois au patient : "simulation" hors production, seule option tant qu'aucun fournisseur n'est retenu.
NOTIFIER="simulation"
# Fichier où la simulation écrit les messages, une ligne JSON par message.
NOTIFIER_SIMULATION_FICHIER=".notifications-dev.jsonl"
# Facturation SESAM-Vitale : "simulation" hors production, seule option avant AreaFSE (étape 26).
BILLING_ENGINE="simulation"
PEC_GATEWAY="simulation"
# Factures reçues. Hors production : "simulation" rend une facture vide, sans lire le PDF. Sans valeur, la couche texte du PDF.
# EXTRACTEUR_FACTURE="simulation"
# Relève de la boîte de factures, simulée, par l'ouvrier. Aucun fournisseur retenu : sans elle, seul le dépôt à l'écran.
# BOITE_FACTURES="simulation"
# Preuve anti-robot : "simulation" hors production, sinon ALTCHA avec le secret CAPTCHA_CLE.
CAPTCHA="simulation"
# CAPTCHA_CLE=

# Signature à l'écran : « simulation » hors production. Sans fournisseur, seul le dépôt du scan est ouvert.
E_SIGNATURE="simulation"
