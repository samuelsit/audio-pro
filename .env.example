# Valeurs de développement local uniquement (docker-compose). Ne jamais y mettre de secret réel.
DATABASE_URL="postgresql://ha:ha@localhost:5433/ha_gestion?schema=public"

S3_ENDPOINT="http://localhost:9000"
S3_REGION="eu-west-3"
S3_ACCESS_KEY="ha-minio"
S3_SECRET_KEY="ha-minio-secret"
S3_BUCKET="ha-documents"

# Base dédiée aux tests d'intégration (vidée à chaque exécution).
DATABASE_URL_TEST="postgresql://ha:ha@localhost:5433/ha_gestion_test?schema=public"

# Authentification (Better Auth). En production : secret aléatoire d'au moins 32 caractères
# (openssl rand -base64 32), jamais versionné.
BETTER_AUTH_SECRET="dev-uniquement-a-remplacer-en-production-0123456789"
BETTER_AUTH_URL="http://localhost:3000"

# Mot de passe des comptes de démonstration créés par `pnpm db:seed` (dev uniquement).
SEED_MOT_DE_PASSE_DEMO="demo-ha-gestion-2026"

# Base dédiée aux tests E2E (vidée puis seedée à chaque exécution de Playwright).
DATABASE_URL_E2E="postgresql://ha:ha@localhost:5433/ha_gestion_e2e?schema=public"
