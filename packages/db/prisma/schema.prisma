generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Métadonnées techniques (version du schéma, date du seed). Aucune donnée métier.
model AppMeta {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_meta")
}

// ---------------------------------------------------------------------------
// Réseau, centres, utilisateurs, praticiens
// ---------------------------------------------------------------------------

enum Role {
  ADMIN_CLIENT
  RESPONSABLE_CENTRE
  AUDIO
  ASSISTANT
  SUPERADMIN
}

enum StatutOrganisation {
  ESSAI
  ACTIF
  SUSPENDU
}

/// Un client : réseau de centres ou centre indépendant. Chaque donnée métier lui est rattachée (ADR-016).
model Organisation {
  id                       String                    @id @default(uuid(7))
  raisonSociale            String                    @map("raison_sociale")
  /// Vide pour une organisation antérieure au SaaS ; exigé à la création depuis la console.
  siren                    String?                   @unique @db.Char(9)
  /// Segment client de l'URL publique de réservation (`/rdv/<slug>/<centre>`).
  slug                     String                    @unique @default(dbgenerated("slug_provisoire()"))
  adresseLigne1            String?                   @map("adresse_ligne1")
  adresseLigne2            String?                   @map("adresse_ligne2")
  codePostal               String?                   @map("code_postal")
  ville                    String?
  statut                   StatutOrganisation        @default(ESSAI)
  parametres               Json                      @default("{}")
  createdAt                DateTime                  @default(now()) @map("created_at")
  updatedAt                DateTime                  @updatedAt @map("updated_at")
  centres                  Centre[]
  utilisateurs             Utilisateur[]
  patients                 Patient[]
  lecturesVitale           LectureVitale[]
  fabricants               Fabricant[]
  centralesAchat           CentraleAchat[]
  fournisseurs             Fournisseur[]
  fournisseurContacts      FournisseurContact[]
  fournisseurComptes       FournisseurCompteCentre[]
  parametresCommande       ParametresCommande?
  parametresSav            ParametresSav?
  garantiesAppareil        GarantieAppareil[]
  compteursSav             CompteurSav[]
  ticketsSav               TicketSav[]
  retoursFabricant         RetourFabricant[]
  reglesCommande           RegleCommande[]
  compteursCommande        CompteurCommande[]
  commandes                Commande[]
  lignesCommande           CommandeLigne[]
  modeles                  ModeleAideAuditive[]
  accessoires              Accessoire[]
  prescripteurs            Prescripteur[]
  appareils                Appareil[]
  mouvementsAppareil       MouvementAppareil[]
  mouvementsAccessoire     MouvementAccessoire[]
  dossiers                 Dossier[]
  delivrances              Delivrance[]
  devis                    Devis[]
  compteursDevis           CompteurDevis[]
  essais                   Essai[]
  factures                 Facture[]
  lignesFacture            LigneFacture[]
  seriesFacture            SerieFacture[]
  chainesCaisse            ChaineCaisse[]
  evenementsCaisse         EvenementCaisse[]
  encaissements            Encaissement[]
  complementaires          Complementaire[]
  creances                 Creance[]
  reglementsOrganismes     ReglementOrganisme[]
  lettrages                Lettrage[]
  regularisations          RegularisationCreance[]
  rejetsCreances           RejetCreance[]
  sessionsCaisse           SessionCaisse[]
  comptagesCaisse          ComptageCaisse[]
  cloturesCaisse           ClotureCaisse[]
  archivesCaisse           ArchiveCaisse[]
  fses                     Fse[]
  journalAudit             JournalAudit[]
  utilisateursCentres      UtilisateurCentre[]
  praticiens               Praticien[]
  praticiensCentres        PraticienCentre[]
  couverturesAmo           CouvertureAmo[]
  couverturesAmc           CouvertureAmc[]
  modelesCodesLpp          ModeleCodeLpp[]
  stocksAccessoires        StockAccessoire[]
  transitionsDossier       TransitionDossier[]
  prescriptions            Prescription[]
  prisesEnCharge           PriseEnCharge[]
  devisOffres              DevisOffre[]
  devisLignes              DevisLigne[]
  signaturesDevis          SignatureDevis[]
  essaisAppareils          EssaiAppareil[]
  essaisRdv                EssaiRdv[]
  prolongationsEssai       ProlongationEssai[]
  cabines                  Cabine[]
  typesRdv                 TypeRdv[]
  exceptionsAgenda         ExceptionAgenda[]
  rendezVous               RendezVous[]
  evenementsDomaine        EvenementDomaine[]
  parametresComptables     ParametresComptables[]
  parametresReservation    ParametresReservation[]
  typesRdvEnLigne          TypeRdvEnLigne[]
  reservationsEnLigne      ReservationEnLigne[]
  notifications            Notification[]
  bilansAudiologiques      BilanAudiologique[]
  inventaires              Inventaire[]
  lignesInventaire         InventaireLigne[]
  liensDocument            LienDocument[]
  mesuresAudiologiques     MesureAudiologique[]
  otoscopies               Otoscopie[]
  modelesFormulaire        ModeleFormulaire[]
  reponsesFormulaire       ReponseFormulaire[]
  receptions               Reception[]
  receptionLignes          ReceptionLigne[]
  receptionLigneAppareils  ReceptionLigneAppareil[]
  ecartAchats              EcartAchat[]
  facturesFournisseurs     FactureFournisseur[]
  lignesFactureFournisseur FactureFournisseurLigne[]
  relevesCentrale          ReleveCentrale[]
  lignesReleveCentrale     ReleveCentraleLigne[]
  seuilsStock              SeuilStock[]

  @@map("organisation")
}

/// Centre (établissement). On ne supprime pas un centre : on le désactive.
model Centre {
  id                    String                    @id @default(uuid(7))
  organisationId        String                    @map("organisation_id")
  nom                   String
  /// Segment centre de l'URL publique de réservation, unique dans le client.
  slug                  String                    @default(dbgenerated("slug_provisoire()"))
  adresseLigne1         String                    @map("adresse_ligne1")
  adresseLigne2         String?                   @map("adresse_ligne2")
  codePostal            String                    @map("code_postal")
  ville                 String
  finess                String?
  /// Identifiant de facturation Assurance Maladie, attribué par établissement.
  numeroFacturationAm   String?                   @map("numero_facturation_am")
  /// Identification de l'entreprise, au pied du devis normalisé (p. 2).
  raisonSociale         String?                   @map("raison_sociale")
  siret                 String?
  rcs                   String?
  tvaIntracommunautaire String?                   @map("tva_intracommunautaire")
  email                 String
  telephone             String
  /// Plages par jour, validées par `horairesOuvertureSchema`.
  horairesOuverture     Json?                     @map("horaires_ouverture")
  actif                 Boolean                   @default(true)
  createdAt             DateTime                  @default(now()) @map("created_at")
  updatedAt             DateTime                  @updatedAt @map("updated_at")
  organisation          Organisation              @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  utilisateurs          UtilisateurCentre[]
  praticiens            PraticienCentre[]
  patients              Patient[]
  lecturesVitale        LectureVitale[]
  appareils             Appareil[]
  retoursFabricant      RetourFabricant[]
  ticketsSav            TicketSav[]
  mouvementsDepart      MouvementAppareil[]       @relation("MouvementCentreAvant")
  mouvementsArrivee     MouvementAppareil[]       @relation("MouvementCentreApres")
  stockAccessoires      StockAccessoire[]
  mouvementsAccessoire  MouvementAccessoire[]
  cabines               Cabine[]
  exceptionsAgenda      ExceptionAgenda[]
  rendezVous            RendezVous[]
  dossiers              Dossier[]
  bilansAudiologiques   BilanAudiologique[]
  inventaires           Inventaire[]
  factures              Facture[]
  serieFacture          SerieFacture?
  chaineCaisse          ChaineCaisse?
  evenementsCaisse      EvenementCaisse[]
  encaissements         Encaissement[]
  creances              Creance[]
  reglementsOrganismes  ReglementOrganisme[]
  lettrages             Lettrage[]
  regularisations       RegularisationCreance[]
  rejetsCreances        RejetCreance[]
  sessionsCaisse        SessionCaisse[]
  comptagesCaisse       ComptageCaisse[]
  cloturesCaisse        ClotureCaisse[]
  archivesCaisse        ArchiveCaisse[]
  parametresComptables  ParametresComptables?
  parametresReservation ParametresReservation?
  typesRdvEnLigne       TypeRdvEnLigne[]
  reservationsEnLigne   ReservationEnLigne[]
  comptesFournisseurs   FournisseurCompteCentre[]
  reglesCommande        RegleCommande[]
  commandes             Commande[]
  receptions            Reception[]
  ecartsAchat           EcartAchat[]
  facturesFournisseurs  FactureFournisseur[]
  seuilsStock           SeuilStock[]

  @@unique([organisationId, slug])
  @@unique([organisationId, nom])
  @@unique([organisationId, finess])
  @@unique([organisationId, numeroFacturationAm])
  @@map("centre")
}

/// Compte utilisateur. Table « user » de Better Auth (noms de champs imposés : name, email,
/// emailVerified, image, twoFactorEnabled), complétée par nos champs métier.
model Utilisateur {
  id                           String                  @id @default(uuid(7))
  /// Null pour le seul SUPERADMIN, hors de toute organisation (CHECK en base).
  organisationId               String?                 @map("organisation_id")
  prenom                       String
  nom                          String
  /// Nom affiché exigé par Better Auth (« Prénom Nom »), maintenu par le service.
  name                         String                  @map("nom_affiche")
  /// Toujours en minuscules.
  email                        String                  @unique
  emailVerified                Boolean                 @default(false) @map("email_verifie")
  image                        String?
  role                         Role
  actif                        Boolean                 @default(true)
  doitChangerMotDePasse        Boolean                 @default(true) @map("doit_changer_mot_de_passe")
  /// 2FA TOTP : obligatoire pour ADMIN_CLIENT et SUPERADMIN, facultative pour les autres rôles.
  twoFactorEnabled             Boolean                 @default(false) @map("deux_facteurs_actif")
  createdAt                    DateTime                @default(now()) @map("created_at")
  updatedAt                    DateTime                @updatedAt @map("updated_at")
  organisation                 Organisation?           @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  centres                      UtilisateurCentre[]
  praticien                    Praticien?
  sessions                     Session[]
  comptes                      Compte[]
  deuxFacteurs                 DeuxFacteurs[]
  lecturesVitale               LectureVitale[]
  retoursFabricant             RetourFabricant[]
  ticketsSavOuverts            TicketSav[]
  mouvementsAppareil           MouvementAppareil[]
  mouvementsAccessoire         MouvementAccessoire[]
  transitionsDossier           TransitionDossier[]
  prescriptionsSaisies         Prescription[]          @relation("PrescriptionSaisie")
  prescriptionsForcees         Prescription[]          @relation("PrescriptionForcee")
  devisCrees                   Devis[]                 @relation("DevisCree")
  devisEmis                    Devis[]                 @relation("DevisEmis")
  signaturesDevis              SignatureDevis[]
  essaisDemarres               Essai[]
  appareilsPoses               EssaiAppareil[]         @relation("EssaiAppareilPose")
  appareilsRetires             EssaiAppareil[]         @relation("EssaiAppareilRetire")
  rdvEssai                     EssaiRdv[]
  prolongationsEssai           ProlongationEssai[]
  facturesCreees               Facture[]               @relation("FactureCreee")
  couverturesConfirmees        Facture[]               @relation("CouvertureConfirmee")
  facturesValidees             Facture[]               @relation("FactureValidee")
  evenementsCaisse             EvenementCaisse[]
  encaissements                Encaissement[]
  reglementsOrganismes         ReglementOrganisme[]
  lettrages                    Lettrage[]
  regularisations              RegularisationCreance[]
  rejetsSaisis                 RejetCreance[]          @relation("RejetSaisi")
  rejetsResolus                RejetCreance[]          @relation("RejetResolu")
  sessionsCaisse               SessionCaisse[]
  comptagesCaisse              ComptageCaisse[]
  cloturesCaisse               ClotureCaisse[]
  archivesCaisse               ArchiveCaisse[]
  fsesSoumises                 Fse[]
  priseEnChargeSaisies         PriseEnCharge[]
  rendezVousCrees              RendezVous[]            @relation("RendezVousCreateur")
  exceptionsCreees             ExceptionAgenda[]       @relation("ExceptionAgendaCreateur")
  bilansCrees                  BilanAudiologique[]
  inventairesOuverts           Inventaire[]            @relation("InventaireOuvertPar")
  liensDocument                LienDocument[]
  inventairesClotures          Inventaire[]            @relation("InventaireCloturePar")
  mesuresAudiologiques         MesureAudiologique[]
  otoscopies                   Otoscopie[]
  modelesFormulaire            ModeleFormulaire[]
  reponsesFormulaire           ReponseFormulaire[]
  commandesDemandees           Commande[]              @relation("CommandeDemandeur")
  commandesApprouvees          Commande[]              @relation("CommandeApprobateur")
  receptions                   Reception[]
  ecartsTraites                EcartAchat[]
  facturesFournisseursValidees FactureFournisseur[]
  relevesImportes              ReleveCentrale[]

  @@index([organisationId])
  @@map("utilisateur")
}

/// Rattachement d'un utilisateur à un centre. Un ADMIN_CLIENT accède à tous les centres sans rattachement.
model UtilisateurCentre {
  organisationId String       @default(dbgenerated("app_organisation_id()")) @map("organisation_id")
  utilisateurId  String       @map("utilisateur_id")
  centreId       String       @map("centre_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  utilisateur    Utilisateur  @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  centre         Centre       @relation(fields: [centreId], references: [id], onDelete: Restrict)
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@id([utilisateurId, centreId])
  @@index([centreId])
  @@index([organisationId])
  @@map("utilisateur_centre")
}

/// Audioprothésiste : fiche liée à un utilisateur de rôle AUDIO (contrôlé par le service).
model Praticien {
  id                  String               @id @default(uuid(7))
  organisationId      String               @default(dbgenerated("app_organisation_id()")) @map("organisation_id")
  utilisateurId       String               @unique @map("utilisateur_id")
  rpps                String               @db.Char(11)
  adeli               String?              @db.Char(9)
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  utilisateur         Utilisateur          @relation(fields: [utilisateurId], references: [id], onDelete: Restrict)
  centres             PraticienCentre[]
  dossiers            Dossier[]
  bilansAudiologiques BilanAudiologique[]
  rendezVous          RendezVous[]
  exceptions          ExceptionAgenda[]
  organisation        Organisation         @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  reservationsEnLigne ReservationEnLigne[]

  @@unique([organisationId, rpps])
  @@unique([organisationId, adeli])
  @@index([organisationId])
  @@map("praticien")
}

/// Centre d'exercice d'un praticien (sous-ensemble des rattachements de son utilisateur).
model PraticienCentre {
  organisationId String       @default(dbgenerated("app_organisation_id()")) @map("organisation_id")
  praticienId    String       @map("praticien_id")
  centreId       String       @map("centre_id")
  /// Horaires hebdomadaires sur ce centre, validés par `horairesOuvertureSchema`. Vide : aucune disponibilité.
  horaires       Json?
  createdAt      DateTime     @default(now()) @map("created_at")
  praticien      Praticien    @relation(fields: [praticienId], references: [id], onDelete: Cascade)
  centre         Centre       @relation(fields: [centreId], references: [id], onDelete: Restrict)
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@id([praticienId, centreId])
  @@index([centreId])
  @@index([organisationId])
  @@map("praticien_centre")
}

// ---------------------------------------------------------------------------
// Patients
// ---------------------------------------------------------------------------

enum Civilite {
  M
  MME
}

enum Sexe {
  MASCULIN
  FEMININ
}

enum QualiteBeneficiaire {
  ASSURE
  AYANT_DROIT
}

enum OrigineDonnee {
  SAISIE
  VITALE
}

/// Fiche patient, visible des utilisateurs qui ont accès à son centre de rattachement.
/// Une fiche fusionnée n'est pas supprimée : elle pointe vers la fiche conservée (`fusionneDansId`).
/// Les couvertures sont lues et écrites directement (jamais par relation imbriquée : champs chiffrés).
model Patient {
  id                    String              @id @default(uuid(7))
  organisationId        String              @map("organisation_id")
  centreId              String              @map("centre_id")
  civilite              Civilite
  nomNaissance          String              @map("nom_naissance")
  nomUsage              String?             @map("nom_usage")
  prenoms               String
  dateNaissance         DateTime            @map("date_naissance") @db.Date
  sexe                  Sexe
  adresseLigne1         String?             @map("adresse_ligne1")
  adresseLigne2         String?             @map("adresse_ligne2")
  codePostal            String?             @map("code_postal")
  ville                 String?
  telephone             String?
  email                 String?
  /// Texte libre pendant le MVP.
  medecinTraitant       String?             @map("medecin_traitant")
  consentementSms       Boolean             @default(false) @map("consentement_sms")
  consentementEmail     Boolean             @default(false) @map("consentement_email")
  consentementCourrier  Boolean             @default(false) @map("consentement_courrier")
  /// Chiffré (contexte « patient.notes ») : peut contenir des données de santé.
  notes                 String?
  /// Formes normalisées (sans accents, majuscules) pour la recherche et les doublons.
  nomNaissanceRecherche String              @map("nom_naissance_recherche")
  nomUsageRecherche     String?             @map("nom_usage_recherche")
  prenomsRecherche      String              @map("prenoms_recherche")
  fusionneDansId        String?             @map("fusionne_dans_id")
  fusionneLe            DateTime?           @map("fusionne_le")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")
  organisation          Organisation        @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  centre                Centre              @relation(fields: [centreId], references: [id], onDelete: Restrict)
  fusionneDans          Patient?            @relation("FusionPatient", fields: [fusionneDansId], references: [id], onDelete: Restrict)
  fusionnes             Patient[]           @relation("FusionPatient")
  couvertureAmo         CouvertureAmo?
  couvertureAmc         CouvertureAmc?
  appareils             Appareil[]
  mouvementsAppareil    MouvementAppareil[]
  garantiesAppareil     GarantieAppareil[]
  ticketsSav            TicketSav[]
  dossiers              Dossier[]
  delivrances           Delivrance[]
  factures              Facture[]
  encaissements         Encaissement[]
  creances              Creance[]
  liensDocument         LienDocument[]
  rendezVous            RendezVous[]
  bilansAudiologiques   BilanAudiologique[]
  lignesCommande        CommandeLigne[]

  @@index([organisationId, nomNaissanceRecherche])
  @@index([organisationId, nomUsageRecherche])
  @@index([organisationId, dateNaissance])
  @@index([centreId])
  @@map("patient")
}

/// Couverture assurance maladie obligatoire (une par patient).
model CouvertureAmo {
  id                    String              @id @default(uuid(7))
  organisationId        String              @default(dbgenerated("app_organisation_id()")) @map("organisation_id")
  patientId             String              @unique @map("patient_id")
  /// NIR complet (15 caractères), chiffré (contexte « couverture_amo.nir »).
  nir                   String
  /// HMAC-SHA256 des 13 premiers caractères : recherche exacte et doublons. Non unique (ayants droit).
  nirEmpreinte          String              @map("nir_empreinte") @db.Char(64)
  rangNaissance         Int                 @map("rang_naissance")
  qualite               QualiteBeneficiaire
  regime                String?
  caisse                String?
  centreGestionnaire    String?             @map("centre_gestionnaire")
  finDroits             DateTime?           @map("fin_droits") @db.Date
  c2s                   Boolean             @default(false)
  /// Indicateur ALD (donnée de santé), chiffré (contexte « couverture_amo.ald ») : « OUI » ou « NON ».
  ald                   String
  origine               OrigineDonnee
  derniereLectureVitale DateTime?           @map("derniere_lecture_vitale")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")
  patient               Patient             @relation(fields: [patientId], references: [id], onDelete: Restrict)
  organisation          Organisation        @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@index([nirEmpreinte])
  @@index([organisationId])
  @@map("couverture_amo")
}

/// Couverture complémentaire (une par patient pendant le MVP).
model CouvertureAmc {
  id                   String       @id @default(uuid(7))
  organisationId       String       @default(dbgenerated("app_organisation_id()")) @map("organisation_id")
  patientId            String       @unique @map("patient_id")
  organismeNom         String       @map("organisme_nom")
  organismeIdentifiant String?      @map("organisme_identifiant")
  numeroAdherent       String?      @map("numero_adherent")
  typeContrat          String?      @map("type_contrat")
  debutValidite        DateTime?    @map("debut_validite") @db.Date
  finValidite          DateTime?    @map("fin_validite") @db.Date
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")
  patient              Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  organisation         Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@index([organisationId])
  @@map("couverture_amc")
}

// ---------------------------------------------------------------------------
// Lectures de la carte Vitale
// ---------------------------------------------------------------------------

enum ResultatLectureVitale {
  SUCCES
  AUCUN_LECTEUR
  CARTE_ABSENTE
  CARTE_INVALIDE
  CARTE_BLOQUEE
  ERREUR_TECHNIQUE
}

enum SourceLectureVitale {
  CARTE
  APCV
}

/// Historique des lectures de la carte Vitale, en ajout seul (trigger, voir la migration).
/// Aucun contenu de la carte (ni nom, ni NIR, ni droits) : seulement qui, quand, où et avec quel résultat.
/// Le lien avec la fiche patient passe par le journal d'audit (`details.lectureVitale`).
model LectureVitale {
  id                  String                @id @default(uuid(7))
  horodatage          DateTime              @default(now())
  organisationId      String                @map("organisation_id")
  utilisateurId       String                @map("utilisateur_id")
  /// Centre courant au moment de la lecture, s'il est unique.
  centreId            String?               @map("centre_id")
  resultat            ResultatLectureVitale
  source              SourceLectureVitale?
  nombreBeneficiaires Int?                  @map("nombre_beneficiaires")
  organisation        Organisation          @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  utilisateur         Utilisateur           @relation(fields: [utilisateurId], references: [id], onDelete: Restrict)
  centre              Centre?               @relation(fields: [centreId], references: [id], onDelete: Restrict)

  @@index([organisationId, horodatage])
  @@index([utilisateurId, horodatage])
  @@map("lecture_vitale")
}

// ---------------------------------------------------------------------------
// Nomenclature LPP (données nationales, importées par `pnpm import:lpp`)
// ---------------------------------------------------------------------------

enum TypeLienLpp {
  COMPATIBLE
  INCOMPATIBLE
}

/// Version importée de la base LPP. Chaque version est un instantané complet et immuable :
/// le tarif applicable se lit dans la dernière version, à la date voulue (voir ADR-008).
model LppVersion {
  numero             Int        @id
  /// Date inscrite dans l'en-tête de la fiche. La date d'actualisation de la note n'est pas lue.
  dateFichiers       DateTime   @map("date_fichiers") @db.Date
  nbCodes            Int        @map("nb_codes")
  nbTarifs           Int        @map("nb_tarifs")
  nbCompatibilites   Int        @map("nb_compatibilites")
  nbIncompatibilites Int        @map("nb_incompatibilites")
  importeeLe         DateTime   @default(now()) @map("importee_le")
  fiches             LppFiche[]
  tarifs             LppTarif[]
  liens              LppLien[]

  @@map("lpp_version")
}

/// Identité stable d'un code du titre II chapitre 3 : cible des clés étrangères du catalogue.
/// Un code absent d'une version ultérieure reste ici.
model LppCode {
  code            String          @id @db.Char(7)
  /// Null pour un code amorcé par le seed, pas encore importé.
  derniereVersion Int?            @map("derniere_version")
  fiches          LppFiche[]
  tarifs          LppTarif[]
  modeles         ModeleCodeLpp[]
  accessoires     Accessoire[]

  @@map("lpp_code")
}

/// Fiche d'un code dans une version (fichier lpp_fiche). `brut` garde la ligne d'origine complète.
model LppFiche {
  versionNumero  Int        @map("version_numero")
  code           String     @db.Char(7)
  libelle        String
  dateFin        DateTime?  @map("date_fin") @db.Date
  ageMax         Int?       @map("age_max")
  typePrestation String?    @map("type_prestation")
  indication     String?
  prothese       String?
  /// OLD_CODE tel quel : code générique, ancien code ou ancien code TIPS.
  oldCode        String?    @map("old_code")
  /// Code générique déduit d'OLD_CODE pour un code spécifique 7xxxxxx (voir ADR-008). Sans clé étrangère.
  codeGenerique  String?    @map("code_generique") @db.Char(7)
  rmo            String[]
  arbo           Int[]
  brut           Json
  version        LppVersion @relation(fields: [versionNumero], references: [numero], onDelete: Cascade)
  lppCode        LppCode    @relation(fields: [code], references: [code], onDelete: Restrict)

  @@id([versionNumero, code])
  @@index([code])
  @@index([versionNumero, codeGenerique])
  @@map("lpp_fiche")
}

/// Ligne d'historique d'un code dans une version (fichier lpp_histo). Bornes de validité incluses.
model LppTarif {
  versionNumero             Int        @map("version_numero")
  code                      String     @db.Char(7)
  debutValidite             DateTime   @map("debut_validite") @db.Date
  finValidite               DateTime?  @map("fin_validite") @db.Date
  naturePrestation          String     @map("nature_prestation")
  entente                   String?
  dateArrete                DateTime?  @map("date_arrete") @db.Date
  dateJo                    DateTime?  @map("date_jo") @db.Date
  puDevis                   Int?       @map("pu_devis")
  /// TARIF : tarif ou base de remboursement.
  baseRemboursementCentimes Int        @map("base_remboursement_centimes")
  /// PUREGLEMEN : null s'il vaut 0 (pas de plafond).
  prixLimiteVenteCentimes   Int?       @map("prix_limite_vente_centimes")
  montantMaxCentimes        Int?       @map("montant_max_centimes")
  quantiteMax               Int?       @map("quantite_max")
  prisesEnCharge            String[]   @map("prises_en_charge")
  /// MAJO_DOM1 à 6, en millièmes (1,300 → 1300).
  majorationsDom            Int[]      @map("majorations_dom")
  brut                      Json
  version                   LppVersion @relation(fields: [versionNumero], references: [numero], onDelete: Cascade)
  lppCode                   LppCode    @relation(fields: [code], references: [code], onDelete: Restrict)

  @@id([versionNumero, code, debutValidite])
  @@index([code])
  @@map("lpp_tarif")
}

/// Compatibilités et incompatibilités (fichiers lpp_comp et lpp_incomp), telles quelles : base entière,
/// donc sans clé étrangère vers `LppCode` qui ne porte que le chapitre 3.
model LppLien {
  versionNumero Int         @map("version_numero")
  type          TypeLienLpp
  code1         String      @db.Char(7)
  code2         String      @db.Char(7)
  version       LppVersion  @relation(fields: [versionNumero], references: [numero], onDelete: Cascade)

  @@id([versionNumero, type, code1, code2])
  @@index([code1])
  @@index([code2])
  @@map("lpp_lien")
}

// ---------------------------------------------------------------------------
// Catalogue
// ---------------------------------------------------------------------------

enum TypeAideAuditive {
  CONTOUR
  INTRA
  RIC
}

enum ClasseLpp {
  CLASSE_I
  CLASSE_II
}

enum NatureAccessoire {
  ACCESSOIRE
  PILE
}

enum LieuFabrication {
  UE
  HORS_UE
}

/// Les 8 options du devis normalisé (p. 1 § 1.1), dont l'offre 100 % santé compte au moins 3.
enum OptionAideAuditive {
  REDUCTEUR_ACOUPHENE
  CONNECTIVITE_SANS_FIL
  REDUCTEUR_BRUIT_VENT
  SYNCHRONISATION_BINAURALE
  DIRECTIVITE_ADAPTATIVE
  BANDE_PASSANTE_ELARGIE
  APPRENTISSAGE_SONIE
  REDUCTEUR_REVERBERATION
}

model Fabricant {
  id             String               @id @default(uuid(7))
  organisationId String               @map("organisation_id")
  nom            String
  /// Mentions du devis normalisé : nullables pour les fiches anciennes, le manque bloque l'émission.
  adresse        String?
  /// Nom et adresse du mandataire d'un fabricant hors UE.
  mandataire     String?
  actif          Boolean              @default(true)
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  organisation   Organisation         @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  modeles        ModeleAideAuditive[]
  appareils      Appareil[]
  fournisseur    Fournisseur?

  @@unique([organisationId, nom])
  @@map("fabricant")
}

model ModeleAideAuditive {
  id                    String               @id @default(uuid(7))
  organisationId        String               @map("organisation_id")
  fabricantId           String               @map("fabricant_id")
  gamme                 String
  nom                   String
  type                  TypeAideAuditive
  classe                ClasseLpp
  prixConseilleCentimes Int                  @map("prix_conseille_centimes")
  /// Réservé aux rôles de gestion. Prix proposé sur une commande (ADR-031).
  prixAchatCentimes     Int?                 @map("prix_achat_centimes")
  /// Mentions du devis normalisé : nullables pour les fiches anciennes, le manque bloque l'émission.
  marque                String?
  referenceCommerciale  String?              @map("reference_commerciale")
  /// Facultatif sur le devis normalisé.
  lieuFabrication       LieuFabrication?     @map("lieu_fabrication")
  nombreCanaux          Int?                 @map("nombre_canaux")
  connectivite          String?
  antiLarsen            Boolean?             @map("anti_larsen")
  reducteurAcouphenes   Boolean?             @map("reducteur_acouphenes")
  bobineT               Boolean?             @map("bobine_t")
  options               OptionAideAuditive[] @default([])
  actif                 Boolean              @default(true)
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")
  organisation          Organisation         @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  fabricant             Fabricant            @relation(fields: [fabricantId], references: [id], onDelete: Restrict)
  codesLpp              ModeleCodeLpp[]
  appareils             Appareil[]
  lignesDevis           DevisLigne[]
  lignesCommande        CommandeLigne[]
  seuilsStock           SeuilStock[]

  /// Cible de la clé composite d'`Appareil` : le fabricant d'un modèle en stock ne peut plus changer.
  @@unique([id, fabricantId])
  @@unique([fabricantId, gamme, nom])
  @@index([organisationId])
  @@map("modele_aide_auditive")
}

/// Codes LPP d'un modèle : génériques ou spécifiques (voir ADR-008).
model ModeleCodeLpp {
  organisationId String             @default(dbgenerated("app_organisation_id()")) @map("organisation_id")
  modeleId       String             @map("modele_id")
  code           String             @db.Char(7)
  modele         ModeleAideAuditive @relation(fields: [modeleId], references: [id], onDelete: Cascade)
  lppCode        LppCode            @relation(fields: [code], references: [code], onDelete: Restrict)
  organisation   Organisation       @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@id([modeleId, code])
  @@index([code])
  @@index([organisationId])
  @@map("modele_code_lpp")
}

/// Accessoire ou boîte de piles.
model Accessoire {
  id                   String                @id @default(uuid(7))
  organisationId       String                @map("organisation_id")
  nom                  String
  nature               NatureAccessoire
  codeLpp              String?               @map("code_lpp") @db.Char(7)
  prixCentimes         Int                   @map("prix_centimes")
  /// Réservé aux rôles de gestion, comme celui d'un appareil. Base de la valeur du stock (ADR-023).
  prixAchatCentimes    Int?                  @map("prix_achat_centimes")
  /// Un accessoire n'a pas de fabricant : ce lien dit à qui le commander (ADR-031).
  fournisseurId        String?               @map("fournisseur_id")
  /// Mentions du devis normalisé : nullables pour les fiches anciennes, le manque bloque l'émission.
  marque               String?
  referenceCommerciale String?               @map("reference_commerciale")
  actif                Boolean               @default(true)
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  organisation         Organisation          @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  lppCode              LppCode?              @relation(fields: [codeLpp], references: [code], onDelete: Restrict)
  fournisseur          Fournisseur?          @relation(fields: [fournisseurId], references: [id], onDelete: Restrict)
  stocks               StockAccessoire[]
  mouvements           MouvementAccessoire[]
  lignesDevis          DevisLigne[]
  lignesInventaire     InventaireLigne[]
  lignesFacture        LigneFacture[]
  lignesCommande       CommandeLigne[]
  seuilsStock          SeuilStock[]

  @@unique([organisationId, nom])
  @@index([codeLpp])
  @@index([fournisseurId])
  @@map("accessoire")
}

// ---------------------------------------------------------------------------
// Achats : fournisseurs (ADR-031)
// ---------------------------------------------------------------------------

enum TypeFournisseur {
  FABRICANT
  FOURNISSEUR
}

/// Regroupe la facturation de fournisseurs dans un relevé mensuel. Ne reçoit jamais les commandes.
model CentraleAchat {
  id             String           @id @default(uuid(7))
  organisationId String           @default(dbgenerated("app_organisation_id()")) @map("organisation_id")
  nom            String
  email          String?
  telephone      String?
  adresse        String?
  actif          Boolean          @default(true)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  fournisseurs   Fournisseur[]
  releves        ReleveCentrale[]

  @@unique([organisationId, nom])
  @@map("centrale_achat")
}

/// Fiche d'achat. `Fabricant` reste la fiche de catalogue du devis : un fabricant commandé a une fiche ici (CHECK).
model Fournisseur {
  id                String                    @id @default(uuid(7))
  organisationId    String                    @default(dbgenerated("app_organisation_id()")) @map("organisation_id")
  type              TypeFournisseur
  nom               String
  fabricantId       String?                   @unique @map("fabricant_id")
  centraleAchatId   String?                   @map("centrale_achat_id")
  /// Sans elle, une commande ne peut pas partir.
  emailCommande     String?                   @map("email_commande")
  /// Reconnaît l'expéditeur d'une facture reçue.
  emailFacturation  String?                   @map("email_facturation")
  telephone         String?
  adresse           String?
  /// Reconnaît le fournisseur sur une facture reçue.
  siret             String?
  conditions        String?
  /// Remplace le délai de relance du client pour ce fournisseur.
  delaiRelanceJours Int?                      @map("delai_relance_jours")
  actif             Boolean                   @default(true)
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")
  organisation      Organisation              @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  fabricant         Fabricant?                @relation(fields: [fabricantId], references: [id], onDelete: Restrict)
  centraleAchat     CentraleAchat?            @relation(fields: [centraleAchatId], references: [id], onDelete: Restrict)
  contacts          FournisseurContact[]
  comptes           FournisseurCompteCentre[]
  accessoires       Accessoire[]
  reglesCommande    RegleCommande[]
  commandes         Commande[]
  factures          FactureFournisseur[]
  retoursFabricant  RetourFabricant[]

  @@unique([organisationId, nom])
  @@index([centraleAchatId])
  @@map("fournisseur")
}

model FournisseurContact {
  id             String       @id @default(uuid(7))
  organisationId String       @default(dbgenerated("app_organisation_id()")) @map("organisation_id")
  fournisseurId  String       @map("fournisseur_id")
  nom            String
  fonction       String?
  email          String?
  telephone      String?
  createdAt      DateTime     @default(now()) @map("created_at")
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  fournisseur    Fournisseur  @relation(fields: [fournisseurId], references: [id], onDelete: Cascade)

  @@index([fournisseurId])
  @@map("fournisseur_contact")
}

/// Numéro de client d'un centre chez un fournisseur : repère le centre sur une facture reçue.
model FournisseurCompteCentre {
  organisationId String       @default(dbgenerated("app_organisation_id()")) @map("organisation_id")
  fournisseurId  String       @map("fournisseur_id")
  centreId       String       @map("centre_id")
  numeroClient   String       @map("numero_client")
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  fournisseur    Fournisseur  @relation(fields: [fournisseurId], references: [id], onDelete: Cascade)
  centre         Centre       @relation(fields: [centreId], references: [id], onDelete: Restrict)

  @@id([fournisseurId, centreId])
  @@unique([fournisseurId, numeroClient])
  @@index([centreId])
  @@map("fournisseur_compte_centre")
}

/// Sans ligne, `PARAMETRES_COMMANDE_DEFAUT` s'applique.
model ParametresCommande {
  organisationId        String       @id @default(dbgenerated("app_organisation_id()")) @map("organisation_id")
  delaiRelanceJours     Int          @map("delai_relance_jours")
  relancesMax           Int          @map("relances_max")
  tolerancePrixCentimes Int          @map("tolerance_prix_centimes")
  /// Adresse unique du client pour ses factures reçues, le centre se lit sur la facture.
  adresseBoiteFactures  String?      @map("adresse_boite_factures")
  updatedAt             DateTime     @updatedAt @map("updated_at")
  organisation          Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@map("parametres_commande")
}

// ---------------------------------------------------------------------------
// Achats : commandes (ADR-031)
// ---------------------------------------------------------------------------

enum StatutCommande {
  BROUILLON
  A_APPROUVER
  APPROUVEE
  ENVOYEE
  PARTIELLEMENT_RECUE
  RECUE
  FACTUREE
  CLOSE
  ANNULEE
}

enum OrigineAccuseCommande {
  LIEN
  SAISIE
}

enum TypeProduitCommande {
  APPAREIL
  ACCESSOIRE
  PILE
}

enum DecisionRegleCommande {
  ENVOI_DIRECT
  APPROBATION
}

/// Décide si une commande part directement. La première règle active qui correspond s'applique, par `priorite`
/// croissante. Un critère nul vaut pour tout. Sans règle, la commande va à l'approbation.
model RegleCommande {
  id                 String                @id @default(uuid(7))
  organisationId     String                @default(dbgenerated("app_organisation_id()")) @map("organisation_id")
  libelle            String
  priorite           Int
  montantMaxCentimes Int?                  @map("montant_max_centimes")
  typeProduit        TypeProduitCommande?  @map("type_produit")
  fournisseurId      String?               @map("fournisseur_id")
  centreId           String?               @map("centre_id")
  decision           DecisionRegleCommande
  actif              Boolean               @default(true)
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")
  organisation       Organisation          @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  fournisseur        Fournisseur?          @relation(fields: [fournisseurId], references: [id], onDelete: Restrict)
  centre             Centre?               @relation(fields: [centreId], references: [id], onDelete: Restrict)
  commandes          Commande[]

  @@index([organisationId, priorite])
  @@index([fournisseurId])
  @@index([centreId])
  @@map("regle_commande")
}

/// Numérotation par client et par année. Une commande n'est pas une pièce comptable : un trou est sans effet.
model CompteurCommande {
  organisationId String       @default(dbgenerated("app_organisation_id()")) @map("organisation_id")
  annee          Int
  dernier        Int
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@id([organisationId, annee])
  @@map("compteur_commande")
}

/// Une demande est une commande en `BROUILLON`. Un fournisseur, un centre. Jamais supprimée.
model Commande {
  id                   String                 @id @default(uuid(7))
  organisationId       String                 @default(dbgenerated("app_organisation_id()")) @map("organisation_id")
  centreId             String                 @map("centre_id")
  fournisseurId        String                 @map("fournisseur_id")
  numero               String
  statut               StatutCommande         @default(BROUILLON)
  demandeurId          String                 @map("demandeur_id")
  /// Règle qui a décidé de l'envoi direct, figée à la soumission.
  regleId              String?                @map("regle_id")
  approbateurId        String?                @map("approbateur_id")
  approuveeLe          DateTime?              @map("approuvee_le") @db.Timestamptz(3)
  /// Chiffré (contexte « commande.motif_refus »).
  motifRefus           String?                @map("motif_refus")
  /// Chiffré (contexte « commande.motif_annulation »).
  motifAnnulation      String?                @map("motif_annulation")
  /// Confiée à l'envoi. La date réelle d'envoi se lit sur la notification.
  envoyeeLe            DateTime?              @map("envoyee_le") @db.Timestamptz(3)
  /// Clé du bon envoyé, dans le stockage chiffré.
  bonPdfCle            String?                @map("bon_pdf_cle")
  accuseLe             DateTime?              @map("accuse_le") @db.Timestamptz(3)
  accuseOrigine        OrigineAccuseCommande? @map("accuse_origine")
  /// Numéro donné par le fabricant.
  referenceFournisseur String?                @map("reference_fournisseur")
  relances             Int                    @default(0)
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")
  organisation         Organisation           @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  centre               Centre                 @relation(fields: [centreId], references: [id], onDelete: Restrict)
  fournisseur          Fournisseur            @relation(fields: [fournisseurId], references: [id], onDelete: Restrict)
  demandeur            Utilisateur            @relation("CommandeDemandeur", fields: [demandeurId], references: [id], onDelete: Restrict)
  approbateur          Utilisateur?           @relation("CommandeApprobateur", fields: [approbateurId], references: [id], onDelete: Restrict)
  regle                RegleCommande?         @relation(fields: [regleId], references: [id], onDelete: Restrict)
  lignes               CommandeLigne[]
  mouvementsAppareil   MouvementAppareil[]
  mouvementsAccessoire MouvementAccessoire[]
  notifications        Notification[]
  receptions           Reception[]
  ecarts               EcartAchat[]

  @@unique([organisationId, numero])
  @@index([centreId, statut])
  @@index([fournisseurId])
  @@index([organisationId, statut])
  @@map("commande")
}

/// Figée par trigger dès l'approbation, hormis les quantités reçues, facturées et abandonnées.
model CommandeLigne {
  id                 String                    @id @default(uuid(7))
  organisationId     String                    @default(dbgenerated("app_organisation_id()")) @map("organisation_id")
  commandeId         String                    @map("commande_id")
  /// Exactement un produit (contrainte CHECK).
  modeleId           String?                   @map("modele_id")
  accessoireId       String?                   @map("accessoire_id")
  quantite           Int
  /// Réservé aux rôles de gestion. Nul tant qu'il est inconnu : la commande va alors à l'approbation.
  prixAchatCentimes  Int?                      @map("prix_achat_centimes")
  enConsignation     Boolean                   @default(false) @map("en_consignation")
  /// Cache des réceptions, écrit sous le verrou de la commande (ADR-031).
  quantiteRecue      Int                       @default(0) @map("quantite_recue")
  /// Cache des factures validées, écrit sous le verrou de la commande.
  quantiteFacturee   Int                       @default(0) @map("quantite_facturee")
  quantiteAbandonnee Int                       @default(0) @map("quantite_abandonnee")
  /// Commande nominative : seul `referencePatient`, aléatoire, sort vers le fabricant.
  patientId          String?                   @map("patient_id")
  referencePatient   String?                   @map("reference_patient")
  oreille            Oreille?
  createdAt          DateTime                  @default(now()) @map("created_at")
  organisation       Organisation              @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  commande           Commande                  @relation(fields: [commandeId], references: [id], onDelete: Restrict)
  modele             ModeleAideAuditive?       @relation(fields: [modeleId], references: [id], onDelete: Restrict)
  accessoire         Accessoire?               @relation(fields: [accessoireId], references: [id], onDelete: Restrict)
  patient            Patient?                  @relation(fields: [patientId], references: [id], onDelete: Restrict)
  lignesReception    ReceptionLigne[]
  ecarts             EcartAchat[]
  lignesFacture      FactureFournisseurLigne[]

  @@unique([organisationId, referencePatient])
  @@index([commandeId])
  @@index([modeleId])
  @@index([accessoireId])
  @@index([patientId])
  @@map("commande_ligne")
}

/// Livraison pointée au centre, en ajout seul (ADR-031).
model Reception {
  id                    String           @id @default(uuid(7))
  organisationId        String           @default(dbgenerated("app_organisation_id()")) @map("organisation_id")
  commandeId            String           @map("commande_id")
  centreId              String           @map("centre_id")
  dateReception         DateTime         @map("date_reception") @db.Date
  referenceBonLivraison String           @map("reference_bon_livraison")
  acteurId              String           @map("acteur_id")
  createdAt             DateTime         @default(now()) @map("created_at")
  organisation          Organisation     @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  commande              Commande         @relation(fields: [commandeId], references: [id], onDelete: Restrict)
  centre                Centre           @relation(fields: [centreId], references: [id], onDelete: Restrict)
  acteur                Utilisateur      @relation(fields: [acteurId], references: [id], onDelete: Restrict)
  lignes                ReceptionLigne[]
  ecarts                EcartAchat[]

  @@index([commandeId])
  @@index([organisationId])
  @@map("reception")
}

model ReceptionLigne {
  id                  String                   @id @default(uuid(7))
  organisationId      String                   @default(dbgenerated("app_organisation_id()")) @map("organisation_id")
  receptionId         String                   @map("reception_id")
  commandeLigneId     String                   @map("commande_ligne_id")
  /// Entrée en stock. Un produit non conforme n'y entre pas : il reste dans `quantiteNonConforme`.
  quantite            Int
  quantiteNonConforme Int                      @default(0) @map("quantite_non_conforme")
  organisation        Organisation             @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  reception           Reception                @relation(fields: [receptionId], references: [id], onDelete: Restrict)
  commandeLigne       CommandeLigne            @relation(fields: [commandeLigneId], references: [id], onDelete: Restrict)
  appareils           ReceptionLigneAppareil[]

  @@index([receptionId])
  @@index([commandeLigneId])
  @@map("reception_ligne")
}

/// Relie un appareil reçu à sa ligne : le rapprochement d'une facture compare les numéros de série.
model ReceptionLigneAppareil {
  organisationId   String         @default(dbgenerated("app_organisation_id()")) @map("organisation_id")
  receptionLigneId String         @map("reception_ligne_id")
  appareilId       String         @unique @map("appareil_id")
  organisation     Organisation   @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  receptionLigne   ReceptionLigne @relation(fields: [receptionLigneId], references: [id], onDelete: Restrict)
  appareil         Appareil       @relation(fields: [appareilId], references: [id], onDelete: Restrict)

  @@id([receptionLigneId, appareilId])
  @@map("reception_ligne_appareil")
}

enum TypeEcartAchat {
  QUANTITE_MANQUANTE
  SURPLUS
  PRODUIT_NON_CONFORME
  PRIX
  QUANTITE_FACTUREE
  LIGNE_NON_COMMANDEE
  SERIE_INCONNUE
  SERIE_ABSENTE
  SERIE_DEJA_FACTUREE
  TOTAL_INCOHERENT
}

enum StatutEcartAchat {
  OUVERT
  ACCEPTE
  CONTESTE
  RESOLU
}

enum StatutFactureFournisseur {
  A_VALIDER
  VALIDEE
  REJETEE
}

enum OrigineFactureFournisseur {
  EMAIL
  DEPOT
  PLATEFORME
}

/// Facture reçue d'un fournisseur. Hors chaîne de caisse : un achat, pas un encaissement (ADR-031). Figée à la
/// validation par trigger. Tant qu'elle attend, fournisseur, centre et montants viennent de l'extraction.
model FactureFournisseur {
  id                 String                    @id @default(uuid(7))
  organisationId     String                    @default(dbgenerated("app_organisation_id()")) @map("organisation_id")
  statut             StatutFactureFournisseur  @default(A_VALIDER)
  origine            OrigineFactureFournisseur
  /// Clé du PDF, dans le stockage chiffré.
  documentCle        String                    @map("document_cle")
  /// SHA-256 du PDF : le même fichier ne rentre pas deux fois (index partiel).
  documentEmpreinte  String                    @map("document_empreinte")
  /// Identifiant dans la boîte ou sur la plateforme : un message se relit sans doublon (index partiel).
  identifiantExterne String?                   @map("identifiant_externe")
  expediteur         String?
  /// L'expéditeur ne correspond à aucune fiche : à regarder de plus près avant de valider.
  expediteurInconnu  Boolean                   @default(false) @map("expediteur_inconnu")
  fournisseurId      String?                   @map("fournisseur_id")
  centreId           String?                   @map("centre_id")
  numero             String?
  dateFacture        DateTime?                 @map("date_facture") @db.Date
  montantHtCentimes  Int?                      @map("montant_ht_centimes")
  montantTvaCentimes Int?                      @map("montant_tva_centimes")
  montantTtcCentimes Int?                      @map("montant_ttc_centimes")
  validateurId       String?                   @map("validateur_id")
  valideeLe          DateTime?                 @map("validee_le") @db.Timestamptz(3)
  /// Chiffré (contexte « facture_fournisseur.motif_rejet »).
  motifRejet         String?                   @map("motif_rejet")
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")
  organisation       Organisation              @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  fournisseur        Fournisseur?              @relation(fields: [fournisseurId], references: [id], onDelete: Restrict)
  centre             Centre?                   @relation(fields: [centreId], references: [id], onDelete: Restrict)
  validateur         Utilisateur?              @relation(fields: [validateurId], references: [id], onDelete: Restrict)
  lignes             FactureFournisseurLigne[]
  ecarts             EcartAchat[]
  lignesReleve       ReleveCentraleLigne[]

  @@index([organisationId, statut])
  @@index([centreId, statut])
  @@index([fournisseurId])
  @@map("facture_fournisseur")
}

model FactureFournisseurLigne {
  id                   String             @id @default(uuid(7))
  organisationId       String             @default(dbgenerated("app_organisation_id()")) @map("organisation_id")
  factureId            String             @map("facture_id")
  rang                 Int
  commandeLigneId      String?            @map("commande_ligne_id")
  reference            String?
  /// Chiffré (contexte « facture_fournisseur_ligne.designation ») : un fabricant peut y citer un patient.
  designation          String
  quantite             Int
  prixUnitaireCentimes Int                @map("prix_unitaire_centimes")
  /// En points de base, lu sur la facture : 2000 pour 20 %. Nul s'il n'y figure pas.
  tauxTvaPointsBase    Int?               @map("taux_tva_points_base")
  numerosSerie         String[]           @default([]) @map("numeros_serie")
  organisation         Organisation       @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  facture              FactureFournisseur @relation(fields: [factureId], references: [id], onDelete: Restrict)
  commandeLigne        CommandeLigne?     @relation(fields: [commandeLigneId], references: [id], onDelete: Restrict)

  @@unique([factureId, rang])
  @@index([commandeLigneId])
  @@map("facture_fournisseur_ligne")
}

enum EtatPointageReleve {
  POINTEE
  MANQUANTE
  MONTANT_DIFFERENT
}

/// Relevé mensuel d'une centrale : il regroupe des factures, qui restent celles des fabricants (ADR-031).
model ReleveCentrale {
  id              String                @id @default(uuid(7))
  organisationId  String                @default(dbgenerated("app_organisation_id()")) @map("organisation_id")
  centraleAchatId String                @map("centrale_achat_id")
  /// AAAA-MM.
  mois            String
  /// PDF source, s'il a été joint, dans le stockage chiffré.
  documentCle     String?               @map("document_cle")
  importeParId    String                @map("importe_par_id")
  createdAt       DateTime              @default(now()) @map("created_at")
  organisation    Organisation          @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  centraleAchat   CentraleAchat         @relation(fields: [centraleAchatId], references: [id], onDelete: Restrict)
  importePar      Utilisateur           @relation(fields: [importeParId], references: [id], onDelete: Restrict)
  lignes          ReleveCentraleLigne[]

  @@unique([centraleAchatId, mois])
  @@index([organisationId])
  @@map("releve_centrale")
}

/// `etat` et `factureFournisseurId` se recalculent : une facture peut arriver après le relevé.
model ReleveCentraleLigne {
  id                   String              @id @default(uuid(7))
  organisationId       String              @default(dbgenerated("app_organisation_id()")) @map("organisation_id")
  releveId             String              @map("releve_id")
  rang                 Int
  numeroFacture        String              @map("numero_facture")
  fournisseur          String
  dateFacture          DateTime            @map("date_facture") @db.Date
  montantTtcCentimes   Int                 @map("montant_ttc_centimes")
  etat                 EtatPointageReleve
  factureFournisseurId String?             @map("facture_fournisseur_id")
  organisation         Organisation        @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  releve               ReleveCentrale      @relation(fields: [releveId], references: [id], onDelete: Restrict)
  facture              FactureFournisseur? @relation(fields: [factureFournisseurId], references: [id], onDelete: Restrict)

  @@unique([releveId, rang])
  @@index([factureFournisseurId])
  @@map("releve_centrale_ligne")
}

/// Seuil de réapprovisionnement d'un produit dans un centre. Sous `minimum`, on propose de remonter à `cible`.
model SeuilStock {
  id             String              @id @default(uuid(7))
  organisationId String              @default(dbgenerated("app_organisation_id()")) @map("organisation_id")
  centreId       String              @map("centre_id")
  /// Exactement un produit (contrainte CHECK), une fois par centre (index partiels).
  modeleId       String?             @map("modele_id")
  accessoireId   String?             @map("accessoire_id")
  minimum        Int
  cible          Int
  updatedAt      DateTime            @updatedAt @map("updated_at")
  organisation   Organisation        @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  centre         Centre              @relation(fields: [centreId], references: [id], onDelete: Restrict)
  modele         ModeleAideAuditive? @relation(fields: [modeleId], references: [id], onDelete: Restrict)
  accessoire     Accessoire?         @relation(fields: [accessoireId], references: [id], onDelete: Restrict)

  @@index([centreId])
  @@index([modeleId])
  @@index([accessoireId])
  @@map("seuil_stock")
}

/// Écart à traiter, relevé à la réception ou au rapprochement d'une facture.
model EcartAchat {
  id                      String              @id @default(uuid(7))
  organisationId          String              @default(dbgenerated("app_organisation_id()")) @map("organisation_id")
  centreId                String              @map("centre_id")
  commandeId              String?             @map("commande_id")
  commandeLigneId         String?             @map("commande_ligne_id")
  receptionId             String?             @map("reception_id")
  factureFournisseurId    String?             @map("facture_fournisseur_id")
  type                    TypeEcartAchat
  statut                  StatutEcartAchat    @default(OUVERT)
  quantiteAttendue        Int?                @map("quantite_attendue")
  quantiteConstatee       Int?                @map("quantite_constatee")
  /// Réservés aux rôles de gestion, comme tout prix d'achat.
  montantAttenduCentimes  Int?                @map("montant_attendu_centimes")
  montantConstateCentimes Int?                @map("montant_constate_centimes")
  numeroSerie             String?             @map("numero_serie")
  /// Chiffré (contexte « ecart_achat.commentaire ») : texte libre.
  commentaire             String?
  traiteParId             String?             @map("traite_par_id")
  traiteLe                DateTime?           @map("traite_le") @db.Timestamptz(3)
  createdAt               DateTime            @default(now()) @map("created_at")
  organisation            Organisation        @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  centre                  Centre              @relation(fields: [centreId], references: [id], onDelete: Restrict)
  commande                Commande?           @relation(fields: [commandeId], references: [id], onDelete: Restrict)
  commandeLigne           CommandeLigne?      @relation(fields: [commandeLigneId], references: [id], onDelete: Restrict)
  reception               Reception?          @relation(fields: [receptionId], references: [id], onDelete: Restrict)
  factureFournisseur      FactureFournisseur? @relation(fields: [factureFournisseurId], references: [id], onDelete: Restrict)
  traitePar               Utilisateur?        @relation(fields: [traiteParId], references: [id], onDelete: Restrict)
  retoursFabricant        RetourFabricant[]

  @@index([centreId, statut])
  @@index([commandeId, statut])
  @@index([factureFournisseurId])
  @@index([organisationId, statut])
  @@map("ecart_achat")
}

// ---------------------------------------------------------------------------
// Stock
// ---------------------------------------------------------------------------

enum StatutAppareil {
  EN_STOCK
  RESERVE
  EN_ESSAI
  VENDU
  RETOUR_FABRICANT
  SAV
  PRET
  REMPLACE
}

enum TypeMouvementAppareil {
  RECEPTION
  CHANGEMENT_STATUT
  TRANSFERT
  ANNULATION_VENTE
  ECHANGE
}

enum TypeMouvementAccessoire {
  ENTREE
  SORTIE
  TRANSFERT_SORTANT
  TRANSFERT_ENTRANT
  INVENTAIRE_ENTREE
  INVENTAIRE_SORTIE
}

enum StatutInventaire {
  EN_COURS
  CLOTURE
}

/// Aide auditive physique, suivie au numéro de série. Jamais supprimée (traçabilité, convention art. 21).
/// `statut`, `centreId` et `patientId` ne changent que par le service, avec un mouvement (voir ADR-010).
model Appareil {
  id                        String                  @id @default(uuid(7))
  organisationId            String                  @map("organisation_id")
  modeleId                  String                  @map("modele_id")
  /// Copie du fabricant du modèle, tenue à jour par la clé composite : porte l'unicité du numéro de série.
  fabricantId               String                  @map("fabricant_id")
  centreId                  String                  @map("centre_id")
  /// Forme normalisée (sans espaces, majuscules).
  numeroSerie               String                  @map("numero_serie")
  statut                    StatutAppareil          @default(EN_STOCK)
  /// Patient rattaché : réservation, essai, prêt, vente, et SAV ou retour d'un appareil vendu. Un appareil
  /// `REMPLACE` n'a plus de détenteur : son historique garde le patient.
  patientId                 String?                 @map("patient_id")
  dateReception             DateTime                @map("date_reception") @db.Date
  referenceBonLivraison     String                  @map("reference_bon_livraison")
  referenceFactureFabricant String?                 @map("reference_facture_fabricant")
  /// Réservé à l'ADMIN_CLIENT (lecture et saisie).
  prixAchatCentimes         Int?                    @map("prix_achat_centimes")
  enConsignation            Boolean                 @default(false) @map("en_consignation")
  /// Appareil du parc de prêt du centre : ni réservé, ni essayé, ni vendu (ADR-032).
  parcPret                  Boolean                 @default(false) @map("parc_pret")
  /// Appareil qui remplace celui-ci après un échange. Renseigné si et seulement si le statut est `REMPLACE`.
  remplaceParId             String?                 @unique @map("remplace_par_id")
  createdAt                 DateTime                @default(now()) @map("created_at")
  updatedAt                 DateTime                @updatedAt @map("updated_at")
  organisation              Organisation            @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  modele                    ModeleAideAuditive      @relation(fields: [modeleId, fabricantId], references: [id, fabricantId], onDelete: Restrict, onUpdate: Restrict)
  fabricant                 Fabricant               @relation(fields: [fabricantId], references: [id], onDelete: Restrict)
  centre                    Centre                  @relation(fields: [centreId], references: [id], onDelete: Restrict)
  patient                   Patient?                @relation(fields: [patientId], references: [id], onDelete: Restrict)
  mouvements                MouvementAppareil[]
  essais                    EssaiAppareil[]
  lignesInventaire          InventaireLigne[]
  lignesFacture             LigneFacture[]
  receptionLigne            ReceptionLigneAppareil?
  remplacePar               Appareil?               @relation("EchangeAppareil", fields: [remplaceParId], references: [id], onDelete: Restrict)
  remplace                  Appareil?               @relation("EchangeAppareil")
  garantie                  GarantieAppareil?
  tickets                   TicketSav[]             @relation("TicketAppareil")
  ticketsRemplacant         TicketSav[]             @relation("TicketRemplacant")
  retoursFabricant          RetourFabricant[]

  @@unique([fabricantId, numeroSerie])
  @@index([organisationId, numeroSerie])
  @@index([centreId, statut])
  @@index([modeleId])
  @@index([patientId])
  @@map("appareil")
}

/// Garantie d'un appareil vendu, née avec la vente. Un avoir qui solde la retire, la revente la recrée.
/// Après un échange, le remplaçant reprend la date de fin de l'appareil échangé (`origineId`, ADR-032).
model GarantieAppareil {
  id             String            @id @default(uuid(7))
  organisationId String            @default(dbgenerated("app_organisation_id()")) @map("organisation_id")
  appareilId     String            @unique @map("appareil_id")
  patientId      String            @map("patient_id")
  dateDebut      DateTime          @map("date_debut") @db.Date
  /// Dernier jour couvert.
  dateFin        DateTime          @map("date_fin") @db.Date
  origineId      String?           @unique @map("origine_id")
  /// Assurance perte, vol, casse : souscrite si `assureur` est renseigné, avec `assuranceFin`.
  assureur       String?
  contrat        String?
  assuranceFin   DateTime?         @map("assurance_fin") @db.Date
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  organisation   Organisation      @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  appareil       Appareil          @relation(fields: [appareilId], references: [id], onDelete: Restrict)
  patient        Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  origine        GarantieAppareil? @relation("EchangeGarantie", fields: [origineId], references: [id], onDelete: Restrict)
  reprise        GarantieAppareil? @relation("EchangeGarantie")

  @@index([patientId])
  @@index([organisationId, dateFin])
  @@map("garantie_appareil")
}

enum MotifSav {
  PANNE
  CASSE
  PERTE
  VOL
  ENTRETIEN
  AUTRE
}

enum ActionSav {
  REPARATION_CENTRE
  ENVOI_FABRICANT
  ECHANGE
}

enum StatutTicketSav {
  OUVERT
  EN_COURS
  CHEZ_FABRICANT
  A_RESTITUER
  CLOTURE
  ANNULE
}

enum CouvertureSav {
  GARANTIE
  ASSURANCE
  AUCUNE
}

/// Numéros des tickets et des bons de retour : un compteur par client, par nature et par an.
model CompteurSav {
  organisationId String       @default(dbgenerated("app_organisation_id()")) @map("organisation_id")
  nature         String
  annee          Int
  dernier        Int
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@id([organisationId, nature, annee])
  @@map("compteur_sav")
}

/// Ticket SAV d'un appareil. Le centre est celui de l'appareil ; le patient est nul pour un appareil repris
/// sans vente. Au plus un ticket ouvert par appareil (index unique partiel, voir la migration).
/// `description`, `diagnostic`, `motifAnnulation` et `motifFacturation` sont chiffrés. Lu directement.
model TicketSav {
  id                   String              @id @default(uuid(7))
  organisationId       String              @default(dbgenerated("app_organisation_id()")) @map("organisation_id")
  numero               String
  centreId             String              @map("centre_id")
  patientId            String?             @map("patient_id")
  appareilId           String              @map("appareil_id")
  /// Remplaçant reçu, en attente de remise : l'appareil reste réservé tant que le ticket est ouvert.
  appareilRemplacantId String?             @map("appareil_remplacant_id")
  motif                MotifSav
  description          String?
  diagnostic           String?
  action               ActionSav?
  statut               StatutTicketSav     @default(OUVERT)
  /// Calculée à l'ouverture, recalculée à cette date si le diagnostic change le motif.
  couverture           CouvertureSav
  coutCentimes         Int?                @map("cout_centimes")
  factureId            String?             @map("facture_id")
  motifFacturation     String?             @map("motif_facturation")
  motifAnnulation      String?             @map("motif_annulation")
  dateOuverture        DateTime            @map("date_ouverture") @db.Date
  dateDiagnostic       DateTime?           @map("date_diagnostic") @db.Date
  dateReparation       DateTime?           @map("date_reparation") @db.Date
  dateCloture          DateTime?           @map("date_cloture") @db.Date
  ouvertParId          String              @map("ouvert_par_id")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  organisation         Organisation        @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  centre               Centre              @relation(fields: [centreId], references: [id], onDelete: Restrict)
  patient              Patient?            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  appareil             Appareil            @relation("TicketAppareil", fields: [appareilId], references: [id], onDelete: Restrict)
  appareilRemplacant   Appareil?           @relation("TicketRemplacant", fields: [appareilRemplacantId], references: [id], onDelete: Restrict)
  facture              Facture?            @relation(fields: [factureId], references: [id], onDelete: Restrict)
  ouvertPar            Utilisateur         @relation(fields: [ouvertParId], references: [id], onDelete: Restrict)
  mouvements           MouvementAppareil[]
  retours              RetourFabricant[]

  @@unique([organisationId, numero])
  @@index([centreId, statut])
  @@index([appareilId])
  @@index([appareilRemplacantId])
  @@index([patientId])
  @@index([factureId])
  @@map("ticket_sav")
}

enum StatutRetourFabricant {
  PREPARE
  ENVOYE
  REPARE
  ECHANGE
  REFUSE
  ANNULE
}

/// Retour au fabricant : appareil d'un ticket, appareil en stock, ou produit non conforme jamais entré en stock
/// (`ecartAchatId`). `descriptionPanne` est chiffrée : elle part sur le bon de retour.
model RetourFabricant {
  id               String                @id @default(uuid(7))
  organisationId   String                @default(dbgenerated("app_organisation_id()")) @map("organisation_id")
  numero           String
  centreId         String                @map("centre_id")
  fournisseurId    String                @map("fournisseur_id")
  ticketSavId      String?               @map("ticket_sav_id")
  appareilId       String?               @map("appareil_id")
  ecartAchatId     String?               @map("ecart_achat_id")
  descriptionPanne String?               @map("description_panne")
  bonPdfCle        String?               @map("bon_pdf_cle")
  transporteur     String?
  numeroSuivi      String?               @map("numero_suivi")
  statut           StatutRetourFabricant @default(PREPARE)
  dateBon          DateTime              @map("date_bon") @db.Date
  dateEnvoi        DateTime?             @map("date_envoi") @db.Date
  dateRetour       DateTime?             @map("date_retour") @db.Date
  createdById      String                @map("created_by_id")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  organisation     Organisation          @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  centre           Centre                @relation(fields: [centreId], references: [id], onDelete: Restrict)
  fournisseur      Fournisseur           @relation(fields: [fournisseurId], references: [id], onDelete: Restrict)
  ticketSav        TicketSav?            @relation(fields: [ticketSavId], references: [id], onDelete: Restrict)
  appareil         Appareil?             @relation(fields: [appareilId], references: [id], onDelete: Restrict)
  ecartAchat       EcartAchat?           @relation(fields: [ecartAchatId], references: [id], onDelete: Restrict)
  createdBy        Utilisateur           @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([organisationId, numero])
  @@index([centreId, statut])
  @@index([ticketSavId])
  @@index([appareilId])
  @@index([ecartAchatId])
  @@index([fournisseurId])
  @@map("retour_fabricant")
}

/// Sans ligne, `PARAMETRES_SAV_DEFAUT` s'applique.
model ParametresSav {
  organisationId    String       @id @default(dbgenerated("app_organisation_id()")) @map("organisation_id")
  dureeGarantieMois Int          @map("duree_garantie_mois")
  suiviMois         Int[]        @map("suivi_mois")
  suiviParAn        Int          @map("suivi_par_an")
  pretDureeJours    Int          @map("pret_duree_jours")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  organisation      Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@map("parametres_sav")
}

/// Historique d'un appareil, en ajout seul (trigger, voir la migration). Écrit dans la même transaction
/// que le changement de statut ou de centre. Lu directement, jamais par relation imbriquée : motif chiffré.
model MouvementAppareil {
  id             String                @id @default(uuid(7))
  organisationId String                @map("organisation_id")
  appareilId     String                @map("appareil_id")
  type           TypeMouvementAppareil
  horodatage     DateTime              @default(now())
  utilisateurId  String                @map("utilisateur_id")
  /// Null pour la réception.
  statutAvant    StatutAppareil?       @map("statut_avant")
  statutApres    StatutAppareil        @map("statut_apres")
  /// Null pour la réception.
  centreAvantId  String?               @map("centre_avant_id")
  centreApresId  String                @map("centre_apres_id")
  patientId      String?               @map("patient_id")
  /// Dossier qui a provoqué le mouvement : essai, puis vente à l'étape 14.
  dossierId      String?               @map("dossier_id")
  /// Commande fabricant à l'origine de la réception.
  commandeId     String?               @map("commande_id")
  /// Ticket SAV qui a provoqué le mouvement.
  ticketSavId    String?               @map("ticket_sav_id")
  /// Chiffré (contexte « mouvement_appareil.motif ») : texte libre. Null pour la réception.
  motif          String?
  organisation   Organisation          @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  appareil       Appareil              @relation(fields: [appareilId], references: [id], onDelete: Restrict)
  utilisateur    Utilisateur           @relation(fields: [utilisateurId], references: [id], onDelete: Restrict)
  centreAvant    Centre?               @relation("MouvementCentreAvant", fields: [centreAvantId], references: [id], onDelete: Restrict)
  centreApres    Centre                @relation("MouvementCentreApres", fields: [centreApresId], references: [id], onDelete: Restrict)
  patient        Patient?              @relation(fields: [patientId], references: [id], onDelete: Restrict)
  dossier        Dossier?              @relation(fields: [dossierId], references: [id], onDelete: Restrict)
  commande       Commande?             @relation(fields: [commandeId], references: [id], onDelete: Restrict)
  ticketSav      TicketSav?            @relation(fields: [ticketSavId], references: [id], onDelete: Restrict)

  @@index([appareilId, horodatage])
  @@index([patientId])
  @@index([dossierId])
  @@index([commandeId])
  @@index([ticketSavId])
  @@map("mouvement_appareil")
}

/// Quantité d'un accessoire (ou de piles) dans un centre. Jamais négative (contrainte CHECK).
model StockAccessoire {
  organisationId String       @default(dbgenerated("app_organisation_id()")) @map("organisation_id")
  centreId       String       @map("centre_id")
  accessoireId   String       @map("accessoire_id")
  quantite       Int          @default(0)
  updatedAt      DateTime     @updatedAt @map("updated_at")
  centre         Centre       @relation(fields: [centreId], references: [id], onDelete: Restrict)
  accessoire     Accessoire   @relation(fields: [accessoireId], references: [id], onDelete: Restrict)
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@id([centreId, accessoireId])
  @@index([accessoireId])
  @@index([organisationId])
  @@map("stock_accessoire")
}

/// Historique des quantités, en ajout seul (trigger). Lu directement : motif chiffré.
model MouvementAccessoire {
  id             String                  @id @default(uuid(7))
  organisationId String                  @map("organisation_id")
  centreId       String                  @map("centre_id")
  accessoireId   String                  @map("accessoire_id")
  type           TypeMouvementAccessoire
  /// Toujours positive : le sens vient du type.
  quantite       Int
  quantiteApres  Int                     @map("quantite_apres")
  horodatage     DateTime                @default(now())
  utilisateurId  String                  @map("utilisateur_id")
  /// Commande fabricant à l'origine de l'entrée.
  commandeId     String?                 @map("commande_id")
  /// Chiffré (contexte « mouvement_accessoire.motif »).
  motif          String
  organisation   Organisation            @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  centre         Centre                  @relation(fields: [centreId], references: [id], onDelete: Restrict)
  accessoire     Accessoire              @relation(fields: [accessoireId], references: [id], onDelete: Restrict)
  utilisateur    Utilisateur             @relation(fields: [utilisateurId], references: [id], onDelete: Restrict)
  commande       Commande?               @relation(fields: [commandeId], references: [id], onDelete: Restrict)

  @@index([centreId, accessoireId, horodatage])
  @@index([commandeId])
  @@map("mouvement_accessoire")
}

/// Inventaire d'un centre (ADR-023). Un seul ouvert par centre (index partiel), figé une fois clôturé (trigger).
/// `valeurCentimes` et `articlesSansPrix` photographient la valeur à la clôture.
model Inventaire {
  id               String            @id @default(uuid(7))
  organisationId   String            @default(dbgenerated("app_organisation_id()")) @map("organisation_id")
  centreId         String            @map("centre_id")
  statut           StatutInventaire  @default(EN_COURS)
  ouvertParId      String            @map("ouvert_par_id")
  clotureParId     String?           @map("cloture_par_id")
  clotureLe        DateTime?         @map("cloture_le") @db.Timestamptz(3)
  /// Réservés aux rôles de gestion, comme tout prix d'achat.
  valeurCentimes   Int?              @map("valeur_centimes")
  articlesSansPrix Int?              @map("articles_sans_prix")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  organisation     Organisation      @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  centre           Centre            @relation(fields: [centreId], references: [id], onDelete: Restrict)
  ouvertPar        Utilisateur       @relation("InventaireOuvertPar", fields: [ouvertParId], references: [id], onDelete: Restrict)
  cloturePar       Utilisateur?      @relation("InventaireCloturePar", fields: [clotureParId], references: [id], onDelete: Restrict)
  lignes           InventaireLigne[]

  @@index([centreId, createdAt])
  @@index([organisationId])
  @@map("inventaire")
}

/// Appareil (`numeroSerie`) ou accessoire (`accessoireId`) d'un inventaire, jamais les deux (contrainte CHECK).
/// Une ligne d'appareil naît d'un pointage, ou d'une justification pour un appareil non pointé.
/// `quantiteTheorique` est relevée au comptage : les ventes de la journée ne faussent pas l'écart.
/// Lu directement, jamais par relation imbriquée : justification chiffrée.
model InventaireLigne {
  id                String       @id @default(uuid(7))
  organisationId    String       @default(dbgenerated("app_organisation_id()")) @map("organisation_id")
  inventaireId      String       @map("inventaire_id")
  /// Forme normalisée ; le numéro d'un excédent peut être inconnu du stock.
  numeroSerie       String?      @map("numero_serie")
  appareilId        String?      @map("appareil_id")
  pointe            Boolean      @default(false)
  /// Posé à la clôture : l'écart ne se recalcule plus ensuite, le stock ayant bougé.
  ecart             Boolean      @default(false)
  accessoireId      String?      @map("accessoire_id")
  quantiteTheorique Int?         @map("quantite_theorique")
  quantiteComptee   Int?         @map("quantite_comptee")
  /// Chiffré (contexte « inventaire_ligne.justification ») : obligatoire pour clôturer sur un écart.
  justification     String?
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  organisation      Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  inventaire        Inventaire   @relation(fields: [inventaireId], references: [id], onDelete: Restrict)
  appareil          Appareil?    @relation(fields: [appareilId], references: [id], onDelete: Restrict)
  accessoire        Accessoire?  @relation(fields: [accessoireId], references: [id], onDelete: Restrict)

  @@unique([inventaireId, numeroSerie])
  @@unique([inventaireId, accessoireId])
  @@index([organisationId])
  @@index([appareilId])
  @@index([accessoireId])
  @@map("inventaire_ligne")
}

// ---------------------------------------------------------------------------
// Prescripteurs
// ---------------------------------------------------------------------------

enum SpecialitePrescripteur {
  ORL
  MEDECIN_GENERALISTE
  AUTRE
}

/// Médecin prescripteur, commun à l'organisation. RPPS facultatif (création à la volée, ADR-008).
model Prescripteur {
  id                String                 @id @default(uuid(7))
  organisationId    String                 @map("organisation_id")
  nom               String
  prenom            String
  rpps              String?                @db.Char(11)
  specialite        SpecialitePrescripteur
  /// Oui ou non pour un médecin généraliste, null sinon.
  formationOtologie Boolean?               @map("formation_otologie")
  cabinet           String?
  /// Adresse e-mail ou MSSanté.
  contact           String?
  /// Formes normalisées (sans accents, majuscules) pour la recherche.
  nomRecherche      String                 @map("nom_recherche")
  prenomRecherche   String                 @map("prenom_recherche")
  actif             Boolean                @default(true)
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")
  organisation      Organisation           @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  prescriptions     Prescription[]

  @@unique([organisationId, rpps])
  @@index([organisationId, nomRecherche])
  @@map("prescripteur")
}

// ---------------------------------------------------------------------------
// Dossiers d'appareillage
// ---------------------------------------------------------------------------

enum StatutDossier {
  BROUILLON
  PRESCRIPTION_OK
  DEVIS_EMIS
  DEVIS_SIGNE
  EN_ESSAI
  A_FACTURER
  FACTURE
  CLOS
  ABANDONNE
}

enum OreillesDossier {
  DROITE
  GAUCHE
  LES_DEUX
}

enum Oreille {
  DROITE
  GAUCHE
}

enum TypeAppareillage {
  PRIMO
  RENOUVELLEMENT
}

enum OrigineDelivrance {
  DOSSIER
  REPRISE
}

/// Objet central du parcours. `statut` ne change que par le service, avec une transition (voir ADR-011).
/// Lu directement, jamais par relation imbriquée : `surdicecite` est chiffré.
model Dossier {
  id                 String              @id @default(uuid(7))
  organisationId     String              @map("organisation_id")
  patientId          String              @map("patient_id")
  centreId           String              @map("centre_id")
  praticienId        String              @map("praticien_id")
  /// Bilan audiologique de référence, du même patient (contrôle du service, ADR-024).
  bilanReferenceId   String?             @map("bilan_reference_id")
  oreilles           OreillesDossier
  /// Renseigné si et seulement si l'oreille est concernée (contrainte CHECK).
  typeDroite         TypeAppareillage?   @map("type_droite")
  typeGauche         TypeAppareillage?   @map("type_gauche")
  statut             StatutDossier       @default(BROUILLON)
  dateOuverture      DateTime            @map("date_ouverture") @db.Date
  /// Donnée de santé, chiffrée (contexte « dossier.surdicecite ») : « OUI » ou « NON ».
  surdicecite        String
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  organisation       Organisation        @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  patient            Patient             @relation(fields: [patientId], references: [id], onDelete: Restrict)
  centre             Centre              @relation(fields: [centreId], references: [id], onDelete: Restrict)
  praticien          Praticien           @relation(fields: [praticienId], references: [id], onDelete: Restrict)
  bilanReference     BilanAudiologique?  @relation(fields: [bilanReferenceId], references: [id], onDelete: Restrict)
  transitions        TransitionDossier[]
  prescriptions      Prescription[]
  delivrances        Delivrance[]
  rendezVous         RendezVous[]
  mouvementsAppareil MouvementAppareil[]
  devis              Devis[]
  essai              Essai?
  factures           Facture[]
  priseEnCharge      PriseEnCharge?
  liensDocument      LienDocument[]

  @@index([patientId])
  @@index([centreId, statut])
  @@index([bilanReferenceId])
  @@map("dossier")
}

/// Historique des statuts, en ajout seul (trigger). Écrit dans la même transaction que le changement.
/// Lu directement : motif chiffré.
model TransitionDossier {
  id             String         @id @default(uuid(7))
  organisationId String         @default(dbgenerated("app_organisation_id()")) @map("organisation_id")
  dossierId      String         @map("dossier_id")
  /// Null pour la création du dossier.
  statutAvant    StatutDossier? @map("statut_avant")
  statutApres    StatutDossier  @map("statut_apres")
  horodatage     DateTime       @default(now())
  utilisateurId  String         @map("utilisateur_id")
  /// Chiffré (contexte « transition_dossier.motif ») : abandon uniquement.
  motif          String?
  dossier        Dossier        @relation(fields: [dossierId], references: [id], onDelete: Restrict)
  utilisateur    Utilisateur    @relation(fields: [utilisateurId], references: [id], onDelete: Restrict)
  organisation   Organisation   @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@index([dossierId, horodatage])
  @@index([organisationId])
  @@map("transition_dossier")
}

/// Une version de la prescription d'un dossier, en ajout seul (trigger) : la prescription et son scan se
/// conservent (convention art. 21). La plus récente fait foi. Lue directement : motif chiffré.
model Prescription {
  id                    String          @id @default(uuid(7))
  organisationId        String          @default(dbgenerated("app_organisation_id()")) @map("organisation_id")
  dossierId             String          @map("dossier_id")
  prescripteurId        String          @map("prescripteur_id")
  datePrescription      DateTime        @map("date_prescription") @db.Date
  oreilles              OreillesDossier
  mentionRenouvellement Boolean         @map("mention_renouvellement")
  /// Clé opaque dans le DocumentStore. Le nom du fichier d'origine n'est pas conservé.
  scanCle               String          @unique @map("scan_cle")
  scanType              String          @map("scan_type")
  scanTaille            Int             @map("scan_taille")
  /// Erreurs forcées et avertissements relevés à l'enregistrement : codes, sans texte libre.
  controles             Json
  forceeParId           String?         @map("forcee_par_id")
  /// Chiffré (contexte « prescription.motif_forcage »), jamais recopié dans le journal d'audit.
  motifForcage          String?         @map("motif_forcage")
  createdAt             DateTime        @default(now()) @map("created_at")
  createdById           String          @map("created_by_id")
  dossier               Dossier         @relation(fields: [dossierId], references: [id], onDelete: Restrict)
  prescripteur          Prescripteur    @relation(fields: [prescripteurId], references: [id], onDelete: Restrict)
  forceePar             Utilisateur?    @relation("PrescriptionForcee", fields: [forceeParId], references: [id], onDelete: Restrict)
  createdBy             Utilisateur     @relation("PrescriptionSaisie", fields: [createdById], references: [id], onDelete: Restrict)
  factures              Facture[]
  organisation          Organisation    @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@index([dossierId, createdAt])
  @@index([organisationId])
  @@map("prescription")
}

/// Délivrance d'une aide sur une oreille : l'historique du renouvellement (convention art. 22).
/// Écrite à la validation de la facture (étape 14) et par la reprise Cosium (étape 29).
model Delivrance {
  id             String            @id @default(uuid(7))
  organisationId String            @map("organisation_id")
  patientId      String            @map("patient_id")
  oreille        Oreille
  dateDelivrance DateTime          @map("date_delivrance") @db.Date
  /// Null pour une délivrance reprise de Cosium.
  dossierId      String?           @map("dossier_id")
  origine        OrigineDelivrance
  /// Facture qui a marqué la délivrance (R8). Nulle pour une reprise.
  factureId      String?           @map("facture_id")
  /// Renseignés ensemble : un avoir total annule la vente. La ligne reste, hors du délai de 4 ans (ADR-028).
  annuleeLe      DateTime?         @map("annulee_le") @db.Timestamptz(3)
  avoirId        String?           @map("avoir_id")
  createdAt      DateTime          @default(now()) @map("created_at")
  organisation   Organisation      @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  patient        Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  dossier        Dossier?          @relation(fields: [dossierId], references: [id], onDelete: Restrict)
  facture        Facture?          @relation("DelivranceFacture", fields: [factureId], references: [id], onDelete: Restrict)
  avoir          Facture?          @relation("DelivranceAvoir", fields: [avoirId], references: [id], onDelete: Restrict)

  @@index([patientId])
  @@index([factureId])
  @@map("delivrance")
}

// ---------------------------------------------------------------------------
// Devis normalisé
// ---------------------------------------------------------------------------

enum StatutDevis {
  BROUILLON
  EMIS
  SIGNE
  REMPLACE
}

enum RubriqueOffre {
  OFFRE_100_SANTE
  AUTRE_OFFRE
}

enum NatureLigneDevis {
  AIDE_AUDITIVE
  ACCESSOIRE
  PILE
}

enum ModeSignature {
  SCAN
  ELECTRONIQUE
}

/// Dernier numéro attribué, par organisation et par année : le numéro reste le même d'une version à l'autre.
model CompteurDevis {
  organisationId String       @map("organisation_id")
  annee          Int
  dernier        Int
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@id([organisationId, annee])
  @@map("compteur_devis")
}

/// Une version du devis d'un dossier. Tout est figé hors BROUILLON (triggers, voir ADR-012) : modifier
/// crée la version suivante, du même numéro. Le statut du dossier ne change que par le service.
model Devis {
  id                    String          @id @default(uuid(7))
  organisationId        String          @map("organisation_id")
  dossierId             String          @map("dossier_id")
  numero                String
  version               Int
  statut                StatutDevis     @default(BROUILLON)
  lieuEmission          String          @map("lieu_emission")
  validiteMois          Int             @map("validite_mois")
  /// Taux en pour cent, fourni à la saisie (R5).
  tauxAmo               Int             @map("taux_amo")
  refusOffreC2S         Boolean         @map("refus_offre_c2s")
  contratResponsable    Boolean         @map("contrat_responsable")
  bobineTPresentee      Boolean         @map("bobine_t_presentee")
  ficheTechniqueJointe  Boolean         @map("fiche_technique_jointe")
  depotGarantieCentimes Int?            @map("depot_garantie_centimes")
  datePrecedentDroite   DateTime?       @map("date_precedent_droite") @db.Date
  datePrecedentGauche   DateTime?       @map("date_precedent_gauche") @db.Date
  /// Renseignés à l'émission, avec le PDF.
  dateEmission          DateTime?       @map("date_emission") @db.Date
  dateFinValidite       DateTime?       @map("date_fin_validite") @db.Date
  /// Clé opaque dans le DocumentStore : le PDF remis au patient, chiffré.
  pdfCle                String?         @unique @map("pdf_cle")
  pdfTaille             Int?            @map("pdf_taille")
  /// Montants calculés à l'émission, sans identité.
  totaux                Json?
  /// Avertissements relevés à l'émission : codes, sans texte libre.
  controles             Json?
  /// Offres choisies, rubriques 3 et 5 du devis.
  offreEssai            RubriqueOffre?  @map("offre_essai")
  offreRetenue          RubriqueOffre?  @map("offre_retenue")
  /// Scan signé déposé, en attente de l'enregistrement de la signature.
  scanSigneCle          String?         @unique @map("scan_signe_cle")
  scanSigneType         String?         @map("scan_signe_type")
  scanSigneTaille       Int?            @map("scan_signe_taille")
  createdById           String          @map("created_by_id")
  emisParId             String?         @map("emis_par_id")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")
  organisation          Organisation    @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  dossier               Dossier         @relation(fields: [dossierId], references: [id], onDelete: Restrict)
  createdBy             Utilisateur     @relation("DevisCree", fields: [createdById], references: [id], onDelete: Restrict)
  emisPar               Utilisateur?    @relation("DevisEmis", fields: [emisParId], references: [id], onDelete: Restrict)
  offres                DevisOffre[]
  signature             SignatureDevis?
  encaissements         Encaissement[]
  prisesEnCharge        PriseEnCharge[]

  @@unique([dossierId, version])
  @@unique([organisationId, numero, version])
  @@map("devis")
}

/// Rubrique 1.1 ou 1.2 du devis.
model DevisOffre {
  id                      String        @id @default(uuid(7))
  organisationId          String        @default(dbgenerated("app_organisation_id()")) @map("organisation_id")
  devisId                 String        @map("devis_id")
  rubrique                RubriqueOffre
  /// Parts AMC estimées, saisies à la main ; null si inconnues.
  amcDroiteCentimes       Int?          @map("amc_droite_centimes")
  amcGaucheCentimes       Int?          @map("amc_gauche_centimes")
  amcConsommablesCentimes Int?          @map("amc_consommables_centimes")
  devis                   Devis         @relation(fields: [devisId], references: [id], onDelete: Cascade)
  lignes                  DevisLigne[]
  organisation            Organisation  @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@unique([devisId, rubrique])
  @@index([organisationId])
  @@map("devis_offre")
}

/// Aide auditive (une par oreille et par offre) ou consommable. Prix TTC de référence, TVA conservée.
model DevisLigne {
  id                              String              @id @default(uuid(7))
  organisationId                  String              @default(dbgenerated("app_organisation_id()")) @map("organisation_id")
  offreId                         String              @map("offre_id")
  ordre                           Int
  nature                          NatureLigneDevis
  /// Renseignés pour une aide auditive seulement (contrainte CHECK).
  oreille                         Oreille?
  classe                          ClasseLpp?
  modeleId                        String?             @map("modele_id")
  accessoireId                    String?             @map("accessoire_id")
  quantite                        Int
  prixUnitaireAvantRemiseCentimes Int                 @map("prix_unitaire_avant_remise_centimes")
  prixUnitaireCentimes            Int                 @map("prix_unitaire_centimes")
  /// Taux en pour dix mille (À VÉRIFIER, R18).
  tauxTva                         Int                 @map("taux_tva")
  /// Instantané du catalogue : pas de clé étrangère, la LPP et la fiche peuvent évoluer.
  codeLpp                         String?             @map("code_lpp") @db.Char(7)
  designation                     Json
  offre                           DevisOffre          @relation(fields: [offreId], references: [id], onDelete: Cascade)
  modele                          ModeleAideAuditive? @relation(fields: [modeleId], references: [id], onDelete: Restrict)
  accessoire                      Accessoire?         @relation(fields: [accessoireId], references: [id], onDelete: Restrict)
  organisation                    Organisation        @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@unique([offreId, ordre])
  @@index([modeleId])
  @@index([accessoireId])
  @@index([organisationId])
  @@map("devis_ligne")
}

/// Signature d'un devis, en ajout seul (trigger). `SCAN` pour le MVP ; `ELECTRONIQUE` portera sa preuve.
model SignatureDevis {
  id             String        @id @default(uuid(7))
  organisationId String        @default(dbgenerated("app_organisation_id()")) @map("organisation_id")
  devisId        String        @unique @map("devis_id")
  mode           ModeSignature
  dateSignature  DateTime      @map("date_signature") @db.Date
  saisieParId    String        @map("saisie_par_id")
  /// Requis en mode SCAN (contrainte CHECK). Clé opaque dans le DocumentStore.
  scanCle        String?       @unique @map("scan_cle")
  scanType       String?       @map("scan_type")
  scanTaille     Int?          @map("scan_taille")
  /// Référence de la preuve d'une signature électronique, sans donnée patient.
  preuve         Json?
  createdAt      DateTime      @default(now()) @map("created_at")
  devis          Devis         @relation(fields: [devisId], references: [id], onDelete: Restrict)
  saisiePar      Utilisateur   @relation(fields: [saisieParId], references: [id], onDelete: Restrict)
  organisation   Organisation  @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@index([organisationId])
  @@map("signature_devis")
}

/// Issue de l'essai, nulle tant qu'il est en cours.
enum IssueEssai {
  ACHAT
  ABANDON
}

enum TypeRdvEssai {
  POSE
  CONTROLE
  FIN_ESSAI
}

/// Période d'adaptation probatoire d'un dossier (convention art. 18 3°).
model Essai {
  id             String             @id @default(uuid(7))
  organisationId String             @map("organisation_id")
  dossierId      String             @unique @map("dossier_id")
  dateDebut      DateTime           @map("date_debut") @db.Date
  /// Renseignés ensemble, à la conclusion (contrainte CHECK).
  issue          IssueEssai?
  dateFin        DateTime?          @map("date_fin") @db.Date
  createdById    String             @map("created_by_id")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  organisation   Organisation       @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  dossier        Dossier            @relation(fields: [dossierId], references: [id], onDelete: Restrict)
  createdBy      Utilisateur        @relation(fields: [createdById], references: [id], onDelete: Restrict)
  appareils      EssaiAppareil[]
  rdvs           EssaiRdv[]
  prolongation   ProlongationEssai?

  @@index([organisationId, issue])
  @@map("essai")
}

/// Appareil confié pendant l'essai. Un échange ferme la ligne et en ouvre une autre : l'historique reste.
/// Index uniques partiels : un appareil actif par oreille, un seul essai actif par appareil.
model EssaiAppareil {
  id             String       @id @default(uuid(7))
  organisationId String       @default(dbgenerated("app_organisation_id()")) @map("organisation_id")
  essaiId        String       @map("essai_id")
  appareilId     String       @map("appareil_id")
  oreille        Oreille
  poseLe         DateTime     @map("pose_le") @db.Date
  poseParId      String       @map("pose_par_id")
  /// Nul tant que le lien est actif. Posé à la vente, rouvert par un avoir total (ADR-028).
  retireLe       DateTime?    @map("retire_le") @db.Date
  retireParId    String?      @map("retire_par_id")
  /// Chiffré (contexte « essai_appareil.motif_retrait ») : changement d'appareil uniquement.
  motifRetrait   String?      @map("motif_retrait")
  essai          Essai        @relation(fields: [essaiId], references: [id], onDelete: Restrict)
  appareil       Appareil     @relation(fields: [appareilId], references: [id], onDelete: Restrict)
  posePar        Utilisateur  @relation("EssaiAppareilPose", fields: [poseParId], references: [id], onDelete: Restrict)
  retirePar      Utilisateur? @relation("EssaiAppareilRetire", fields: [retireParId], references: [id], onDelete: Restrict)
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@index([essaiId])
  @@index([appareilId])
  @@index([organisationId])
  @@map("essai_appareil")
}

/// Compte rendu d'un rendez-vous d'essai tenu, en ajout seul (trigger). Le créneau est un `RendezVous` (ADR-027).
model EssaiRdv {
  id             String       @id @default(uuid(7))
  organisationId String       @default(dbgenerated("app_organisation_id()")) @map("organisation_id")
  essaiId        String       @map("essai_id")
  rendezVousId   String       @unique @map("rendez_vous_id")
  date           DateTime     @db.Date
  type           TypeRdvEssai
  /// Chiffré (contexte « essai_rdv.compte_rendu ») : données de santé possibles.
  compteRendu    String       @map("compte_rendu")
  createdById    String       @map("created_by_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  essai          Essai        @relation(fields: [essaiId], references: [id], onDelete: Restrict)
  rendezVous     RendezVous   @relation(fields: [rendezVousId], references: [id], onDelete: Restrict)
  createdBy      Utilisateur  @relation(fields: [createdById], references: [id], onDelete: Restrict)
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@index([essaiId, date])
  @@index([organisationId])
  @@map("essai_rdv")
}

/// Prolongation sur demande écrite du prescripteur, dont le justificatif est obligatoire.
model ProlongationEssai {
  id                 String       @id @default(uuid(7))
  organisationId     String       @default(dbgenerated("app_organisation_id()")) @map("organisation_id")
  essaiId            String       @unique @map("essai_id")
  dateDemande        DateTime     @map("date_demande") @db.Date
  jours              Int
  /// Chiffré (contexte « prolongation_essai.motif »), jamais recopié dans le journal d'audit.
  motif              String
  /// Clé opaque dans le DocumentStore. Le nom du fichier d'origine n'est pas conservé.
  justificatifCle    String       @unique @map("justificatif_cle")
  justificatifType   String       @map("justificatif_type")
  justificatifTaille Int          @map("justificatif_taille")
  createdById        String       @map("created_by_id")
  createdAt          DateTime     @default(now()) @map("created_at")
  essai              Essai        @relation(fields: [essaiId], references: [id], onDelete: Restrict)
  createdBy          Utilisateur  @relation(fields: [createdById], references: [id], onDelete: Restrict)
  organisation       Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@index([organisationId])
  @@map("prolongation_essai")
}

// ---------------------------------------------------------------------------
// Facture préparée
// ---------------------------------------------------------------------------

enum StatutPec {
  A_DEMANDER
  DEMANDEE
  ACCORDEE
  PARTIELLE
  REFUSEE
  EXPIREE
  SANS_TIERS_PAYANT
}

enum NaturePiece {
  FACTURE
  AVOIR
}

enum StatutFacture {
  BROUILLON
  VALIDEE
  ABANDONNEE
}

enum NatureLigneFacture {
  AIDE_AUDITIVE
  ACCESSOIRE
  PILE
  ENTRETIEN
}

enum TypeEvenementCaisse {
  FACTURE_VALIDEE
  AVOIR_VALIDE
  ORIGINAL_EMIS
  DUPLICATA_EMIS
  FACTURE_ENVOYEE
  ENCAISSEMENT
  REMBOURSEMENT
  ANNULATION_ENCAISSEMENT
  REGLEMENT_ORGANISME
  ANNULATION_REGLEMENT_ORGANISME
  REGULARISATION_ORGANISME
  CAISSE_OUVERTE
  CAISSE_COMPTEE
  CLOTURE
  ARCHIVAGE
  PARAMETRE_MODIFIE
  VERIFICATION_ECHEC
}

enum ModePaiement {
  CB
  ESPECES
  CHEQUE
  VIREMENT
  FINANCEMENT
}

enum NatureMouvement {
  ENCAISSEMENT
  REMBOURSEMENT
  ANNULATION
}

enum PorteeCloture {
  JOUR
  MOIS
  EXERCICE
}

enum StatutFse {
  EN_ATTENTE
  TRANSMISE
  ACCEPTEE
  REJETEE
}

/// Facture ou avoir d'un centre (ADR-028). Issue de `FacturePreparee` : un brouillon de dossier calcule ses
/// lignes à la lecture, tout est figé à la validation. Lue directement : `motif` est chiffré.
model Facture {
  id                      String            @id @default(uuid(7))
  organisationId          String            @map("organisation_id")
  centreId                String            @map("centre_id")
  patientId               String            @map("patient_id")
  /// Nul sur une vente directe.
  dossierId               String?           @map("dossier_id")
  nature                  NaturePiece       @default(FACTURE)
  statut                  StatutFacture     @default(BROUILLON)
  /// Rang dans la série du centre et numéro imprimé, attribués à la validation.
  numeroSequence          Int?              @map("numero_sequence")
  numero                  String?
  /// Sur un avoir : la facture reprise.
  factureOrigineId        String?           @map("facture_origine_id")
  /// Vente directe : la prescription ouvre le remboursement des lignes LPP (R30).
  prescriptionId          String?           @map("prescription_id")
  /// Motif d'un avoir, chiffré (contexte « facture.motif ») : saisie libre.
  motif                   String?
  /// Jour de la validation, qui vaut date de délivrance (R8, devis p. 2 § 5). Nul sur un brouillon.
  dateFacture             DateTime?         @map("date_facture") @db.Date
  /// Taux AMO d'une vente directe remboursable, en pour cent.
  tauxAmo                 Int?              @map("taux_amo")
  totalTtcCentimes        Int               @default(0) @map("total_ttc_centimes")
  totalHtCentimes         Int               @default(0) @map("total_ht_centimes")
  totalTvaCentimes        Int               @default(0) @map("total_tva_centimes")
  totalAmoCentimes        Int               @default(0) @map("total_amo_centimes")
  totalAmcCentimes        Int               @default(0) @map("total_amc_centimes")
  totalResteCentimes      Int               @default(0) @map("total_reste_centimes")
  /// Acomptes repris à la validation (R35) : le solde reste calculé, ce montant fige la ligne du PDF.
  acomptesDeduitsCentimes Int               @default(0) @map("acomptes_deduits_centimes")
  /// Instantanés à la validation, `vendeurFactureSchema` et `clientFactureSchema`.
  vendeur                 Json?
  client                  Json?
  /// Clé opaque de l'original dans le DocumentStore. Seul champ posé après la validation.
  pdfCle                  String?           @unique @map("pdf_cle")
  valideeLe               DateTime?         @map("validee_le") @db.Timestamptz(3)
  valideeParId            String?           @map("validee_par_id")
  /// Empreinte du maillon de validation dans la chaîne du centre.
  empreinte               String?           @db.Char(64)
  /// Faux : le patient règle aussi la part AMO. Posé sur le brouillon, figé à la validation.
  tiersPayantAmo          Boolean           @default(true) @map("tiers_payant_amo")
  /// Renseignés ensemble (contrainte CHECK) : saisie de la couverture AMO confirmée.
  amoConfirmeeLe          DateTime?         @map("amo_confirmee_le")
  amoConfirmeeParId       String?           @map("amo_confirmee_par_id")
  createdById             String            @map("created_by_id")
  createdAt               DateTime          @default(now()) @map("created_at")
  updatedAt               DateTime          @updatedAt @map("updated_at")
  organisation            Organisation      @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  centre                  Centre            @relation(fields: [centreId], references: [id], onDelete: Restrict)
  patient                 Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  dossier                 Dossier?          @relation(fields: [dossierId], references: [id], onDelete: Restrict)
  prescription            Prescription?     @relation(fields: [prescriptionId], references: [id], onDelete: Restrict)
  factureOrigine          Facture?          @relation("AvoirDeFacture", fields: [factureOrigineId], references: [id], onDelete: Restrict)
  avoirs                  Facture[]         @relation("AvoirDeFacture")
  createdBy               Utilisateur       @relation("FactureCreee", fields: [createdById], references: [id], onDelete: Restrict)
  amoConfirmeePar         Utilisateur?      @relation("CouvertureConfirmee", fields: [amoConfirmeeParId], references: [id], onDelete: Restrict)
  valideePar              Utilisateur?      @relation("FactureValidee", fields: [valideeParId], references: [id], onDelete: Restrict)
  lignes                  LigneFacture[]
  evenementsCaisse        EvenementCaisse[]
  fse                     Fse?
  liensDocument           LienDocument[]
  delivrances             Delivrance[]      @relation("DelivranceFacture")
  delivrancesAnnulees     Delivrance[]      @relation("DelivranceAvoir")
  encaissements           Encaissement[]
  creances                Creance[]
  ticketsSav              TicketSav[]

  @@unique([centreId, numeroSequence])
  @@index([organisationId])
  @@index([centreId, createdAt])
  @@index([patientId])
  @@index([dossierId])
  @@index([factureOrigineId])
  @@map("facture")
}

/// Ligne d'une facture ou d'un avoir. Sur un brouillon, seules les lignes saisies existent, sans montants
/// calculés ; à la validation, toutes les lignes s'écrivent et se figent (trigger `ligne_facture_figee`).
model LigneFacture {
  id                        String             @id @default(uuid(7))
  organisationId            String             @default(dbgenerated("app_organisation_id()")) @map("organisation_id")
  factureId                 String             @map("facture_id")
  rang                      Int
  nature                    NatureLigneFacture
  oreille                   Oreille?
  classe                    ClasseLpp?
  libelle                   String
  codeLpp                   String?            @map("code_lpp")
  codeLppGenerique          Boolean            @default(false) @map("code_lpp_generique")
  /// Nul sur une ligne d'entretien.
  codePrestation            String?            @map("code_prestation")
  numeroSerie               String?            @map("numero_serie")
  appareilId                String?            @map("appareil_id")
  accessoireId              String?            @map("accessoire_id")
  quantite                  Int
  prixUnitaireCentimes      Int                @map("prix_unitaire_centimes")
  prixTtcCentimes           Int                @default(0) @map("prix_ttc_centimes")
  /// Pour dix mille. Nul tant que la ligne n'est pas figée.
  tauxTva                   Int?               @map("taux_tva")
  montantHtCentimes         Int                @default(0) @map("montant_ht_centimes")
  montantTvaCentimes        Int                @default(0) @map("montant_tva_centimes")
  baseRemboursementCentimes Int                @default(0) @map("base_remboursement_centimes")
  amoCentimes               Int                @default(0) @map("amo_centimes")
  amcCentimes               Int                @default(0) @map("amc_centimes")
  resteAChargeCentimes      Int                @default(0) @map("reste_a_charge_centimes")
  /// Sur un avoir : la ligne reprise.
  ligneOrigineId            String?            @map("ligne_origine_id")
  createdAt                 DateTime           @default(now()) @map("created_at")
  organisation              Organisation       @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  facture                   Facture            @relation(fields: [factureId], references: [id], onDelete: Restrict)
  appareil                  Appareil?          @relation(fields: [appareilId], references: [id], onDelete: Restrict)
  accessoire                Accessoire?        @relation(fields: [accessoireId], references: [id], onDelete: Restrict)
  ligneOrigine              LigneFacture?      @relation("LigneAvoir", fields: [ligneOrigineId], references: [id], onDelete: Restrict)
  lignesAvoir               LigneFacture[]     @relation("LigneAvoir")

  @@unique([factureId, rang])
  @@index([organisationId])
  @@index([ligneOrigineId])
  @@map("ligne_facture")
}

/// Série continue d'un centre, factures et avoirs mêlés. La ligne se verrouille à la validation : un rollback
/// rend le numéro, deux validations s'attendent.
model SerieFacture {
  centreId       String       @id @map("centre_id")
  organisationId String       @map("organisation_id")
  prefixe        String       @default("FA")
  dernierNumero  Int          @default(0) @map("dernier_numero")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  centre         Centre       @relation(fields: [centreId], references: [id], onDelete: Restrict)

  @@index([organisationId])
  @@map("serie_facture")
}

/// Tête de la chaîne de caisse d'un centre, verrouillée pour ajouter un maillon.
model ChaineCaisse {
  centreId          String       @id @map("centre_id")
  organisationId    String       @map("organisation_id")
  dernierRang       Int          @default(0) @map("dernier_rang")
  derniereEmpreinte String       @map("derniere_empreinte") @db.Char(64)
  updatedAt         DateTime     @updatedAt @map("updated_at")
  organisation      Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  centre            Centre       @relation(fields: [centreId], references: [id], onDelete: Restrict)

  @@index([organisationId])
  @@map("chaine_caisse")
}

/// Journal des événements de caisse et chaîne d'un centre, en ajout seul (ADR-028, ADR-029). Aucune donnée de
/// santé ni NIR dans `charge`. Format 2 : `createdAt`, `acteurId` et `centreId` entrent dans l'empreinte.
model EvenementCaisse {
  id                  String              @id @default(uuid(7))
  organisationId      String              @map("organisation_id")
  centreId            String              @map("centre_id")
  rang                Int
  /// 1 pour les maillons de l'étape 14, recalculés sans horodatage ni acteur.
  format              Int                 @default(1)
  type                TypeEvenementCaisse
  factureId           String?             @map("facture_id")
  charge              Json
  empreintePrecedente String              @map("empreinte_precedente") @db.Char(64)
  empreinte           String              @db.Char(64)
  /// Nul sur une clôture, un archivage ou un échec de vérification venus d'un travail planifié (CHECK).
  acteurId            String?             @map("acteur_id")
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  organisation        Organisation        @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  centre              Centre              @relation(fields: [centreId], references: [id], onDelete: Restrict)
  facture             Facture?            @relation(fields: [factureId], references: [id], onDelete: Restrict)
  acteur              Utilisateur?        @relation(fields: [acteurId], references: [id], onDelete: Restrict)

  @@unique([centreId, rang])
  @@index([organisationId])
  @@index([factureId])
  @@map("evenement_caisse")
}

/// Encaissement, remboursement ou annulation, en ajout seul (ADR-029). Une correction est une ligne inverse
/// qui pointe vers `origine`. Rattaché à une facture ou, pour un acompte, à un devis signé (CHECK). `rang` et
/// `empreinte` copient le maillon, qui reprend chaque champ probant. Lue directement : champs libres chiffrés.
model Encaissement {
  id              String          @id
  organisationId  String          @map("organisation_id")
  centreId        String          @map("centre_id")
  patientId       String          @map("patient_id")
  factureId       String?         @map("facture_id")
  devisId         String?         @map("devis_id")
  origineId       String?         @map("origine_id")
  nature          NatureMouvement
  mode            ModePaiement
  montantCentimes Int             @map("montant_centimes")
  /// Espèces seulement : remis moins rendu vaut le montant (CHECK).
  remisCentimes   Int?            @map("remis_centimes")
  renduCentimes   Int             @default(0) @map("rendu_centimes")
  /// Chiffrés : saisie libre. Financement saisi à la main, partenaire et nombre d'échéances.
  partenaire      String?
  echeances       Int?
  reference       String?
  motif           String?
  rang            Int
  empreinte       String          @db.Char(64)
  acteurId        String          @map("acteur_id")
  createdAt       DateTime        @map("created_at") @db.Timestamptz(3)
  organisation    Organisation    @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  centre          Centre          @relation(fields: [centreId], references: [id], onDelete: Restrict)
  patient         Patient         @relation(fields: [patientId], references: [id], onDelete: Restrict)
  facture         Facture?        @relation(fields: [factureId], references: [id], onDelete: Restrict)
  devis           Devis?          @relation(fields: [devisId], references: [id], onDelete: Restrict)
  origine         Encaissement?   @relation("MouvementInverse", fields: [origineId], references: [id], onDelete: Restrict)
  inverses        Encaissement[]  @relation("MouvementInverse")
  acteur          Utilisateur     @relation(fields: [acteurId], references: [id], onDelete: Restrict)

  @@unique([centreId, rang])
  @@index([organisationId])
  @@index([centreId, createdAt])
  @@index([patientId])
  @@index([factureId])
  @@index([devisId])
  @@index([origineId])
  @@map("encaissement")
}

/// Ouverture de la caisse physique d'un centre pour une journée, en ajout seul. Distincte de la clôture fiscale.
model SessionCaisse {
  id                  String           @id
  organisationId      String           @map("organisation_id")
  centreId            String           @map("centre_id")
  journee             DateTime         @db.Date
  fondCentimes        Int              @map("fond_centimes")
  /// Ce qui restait au tiroir à la dernière fermeture.
  fondAttenduCentimes Int              @map("fond_attendu_centimes")
  /// Chiffrée : saisie libre, obligatoire si le fond diffère de celui attendu.
  justification       String?
  rang                Int
  empreinte           String           @db.Char(64)
  acteurId            String           @map("acteur_id")
  createdAt           DateTime         @map("created_at") @db.Timestamptz(3)
  organisation        Organisation     @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  centre              Centre           @relation(fields: [centreId], references: [id], onDelete: Restrict)
  acteur              Utilisateur      @relation(fields: [acteurId], references: [id], onDelete: Restrict)
  comptages           ComptageCaisse[]

  @@unique([centreId, journee])
  @@unique([centreId, rang])
  @@index([organisationId])
  @@map("session_caisse")
}

/// Comptage des espèces, en ajout seul : on peut recompter, le dernier fait foi.
model ComptageCaisse {
  id                String        @id
  organisationId    String        @map("organisation_id")
  centreId          String        @map("centre_id")
  sessionId         String        @map("session_id")
  compteesCentimes  Int           @map("comptees_centimes")
  theoriqueCentimes Int           @map("theorique_centimes")
  ecartCentimes     Int           @map("ecart_centimes")
  /// Sorti du tiroir pour la banque : le fond attendu du lendemain en tient compte.
  remiseCentimes    Int           @default(0) @map("remise_centimes")
  /// Chiffrée : saisie libre, obligatoire si l'écart n'est pas nul (CHECK).
  justification     String?
  rang              Int
  empreinte         String        @db.Char(64)
  acteurId          String        @map("acteur_id")
  createdAt         DateTime      @map("created_at") @db.Timestamptz(3)
  organisation      Organisation  @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  centre            Centre        @relation(fields: [centreId], references: [id], onDelete: Restrict)
  session           SessionCaisse @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  acteur            Utilisateur   @relation(fields: [acteurId], references: [id], onDelete: Restrict)

  @@unique([centreId, rang])
  @@index([organisationId])
  @@index([sessionId])
  @@map("comptage_caisse")
}

/// Clôture journalière, mensuelle ou annuelle d'un centre, en ajout seul et signée (ADR-029). Elle couvre une plage
/// de rangs : rien n'est compté deux fois ni oublié. `signature` porte sur l'empreinte du maillon de clôture.
model ClotureCaisse {
  id                        String        @id
  organisationId            String        @map("organisation_id")
  centreId                  String        @map("centre_id")
  portee                    PorteeCloture
  debut                     DateTime      @db.Date
  fin                       DateTime      @db.Date
  rangDebut                 Int           @map("rang_debut")
  rangFin                   Int           @map("rang_fin")
  /// `TotauxCloture` : par mode de paiement et par taux de TVA.
  totaux                    Json
  grandTotalCentimes        BigInt        @map("grand_total_centimes")
  perpetuelCentimes         BigInt        @map("perpetuel_centimes")
  encaissePerpetuelCentimes BigInt        @map("encaisse_perpetuel_centimes")
  versionCaisse             String        @map("version_caisse")
  rang                      Int
  empreinte                 String        @db.Char(64)
  signature                 String
  cleId                     String        @map("cle_id")
  /// Nul : clôture du travail de nuit.
  acteurId                  String?       @map("acteur_id")
  createdAt                 DateTime      @map("created_at") @db.Timestamptz(3)
  organisation              Organisation  @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  centre                    Centre        @relation(fields: [centreId], references: [id], onDelete: Restrict)
  acteur                    Utilisateur?  @relation(fields: [acteurId], references: [id], onDelete: Restrict)

  @@unique([centreId, portee, debut])
  @@unique([centreId, rang])
  @@index([organisationId])
  @@map("cloture_caisse")
}

/// Archive périodique d'un centre, en ajout seul et signée. `empreinteContenu` porte sur le fichier en clair : le
/// DocumentStore le chiffre avec un IV aléatoire. Aucune purge à l'étape 15.
model ArchiveCaisse {
  id               String       @id
  organisationId   String       @map("organisation_id")
  centreId         String       @map("centre_id")
  debut            DateTime     @db.Date
  fin              DateTime     @db.Date
  rangDebut        Int          @map("rang_debut")
  rangFin          Int          @map("rang_fin")
  /// Clé opaque dans le DocumentStore.
  cle              String       @unique
  tailleOctets     Int          @map("taille_octets")
  empreinteContenu String       @map("empreinte_contenu") @db.Char(64)
  versionCaisse    String       @map("version_caisse")
  rang             Int
  empreinte        String       @db.Char(64)
  signature        String
  cleId            String       @map("cle_id")
  acteurId         String?      @map("acteur_id")
  createdAt        DateTime     @map("created_at") @db.Timestamptz(3)
  organisation     Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  centre           Centre       @relation(fields: [centreId], references: [id], onDelete: Restrict)
  acteur           Utilisateur? @relation(fields: [acteurId], references: [id], onDelete: Restrict)

  @@unique([centreId, debut, fin])
  @@unique([centreId, rang])
  @@index([organisationId])
  @@map("archive_caisse")
}

/// Plan de comptes et profil d'export d'un centre. Sans ligne, les valeurs par défaut s'appliquent. Un changement
/// passe au journal de caisse, avec l'avant et l'après.
model ParametresComptables {
  centreId            String       @id @map("centre_id")
  organisationId      String       @map("organisation_id")
  /// `parametresComptablesSchema`.
  comptes             Json
  /// `profilExportSchema`.
  profil              Json
  /// Dernier mois de l'exercice : 12 pour une année civile.
  moisClotureExercice Int          @default(12) @map("mois_cloture_exercice")
  updatedAt           DateTime     @updatedAt @map("updated_at")
  organisation        Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  centre              Centre       @relation(fields: [centreId], references: [id], onDelete: Restrict)

  @@index([organisationId])
  @@map("parametres_comptables")
}

/// FSE préparée depuis une facture validée. Le contenu porte le NIR : chiffré (contexte « fse.contenu »).
model Fse {
  id             String       @id @default(uuid(7))
  organisationId String       @default(dbgenerated("app_organisation_id()")) @map("organisation_id")
  factureId      String       @unique @map("facture_id")
  statut         StatutFse    @default(EN_ATTENTE)
  /// Référence du moteur de facturation, nulle tant que le dépôt n'a pas abouti.
  reference      String?
  motif          String?
  contenu        String
  soumiseParId   String       @map("soumise_par_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  facture        Facture      @relation(fields: [factureId], references: [id], onDelete: Restrict)
  soumisePar     Utilisateur  @relation(fields: [soumiseParId], references: [id], onDelete: Restrict)

  @@index([organisationId])
  @@map("fse")
}

/// Taux de TVA datés par type de produit, globaux et gérés depuis la console (R18). Un changement ajoute une
/// ligne : l'historique ne se réécrit pas.
model TauxTva {
  id        String             @id @default(uuid(7))
  type      NatureLigneFacture
  /// Pour dix mille, 550 pour 5,5 %.
  taux      Int
  debut     DateTime           @db.Date
  createdAt DateTime           @default(now()) @map("created_at")

  @@unique([type, debut])
  @@map("taux_tva")
}

/// Prise en charge complémentaire saisie à la main. Rattachée au dossier : elle pourra précéder l'achat.
model PriseEnCharge {
  id                     String          @id @default(uuid(7))
  organisationId         String          @default(dbgenerated("app_organisation_id()")) @map("organisation_id")
  dossierId              String          @unique @map("dossier_id")
  statut                 StatutPec
  /// Vides sans tiers payant ; organisme, numéro et montant requis si accordée (contraintes CHECK).
  organisme              String?
  plateforme             String?
  numeroAdherent         String?         @map("numero_adherent")
  numeroAccord           String?         @map("numero_accord")
  montantAccordeCentimes Int?            @map("montant_accorde_centimes")
  /// Date de la demande ou de la réponse ; vide tant que la PEC est à demander.
  datePec                DateTime?       @map("date_pec") @db.Date
  validiteFin            DateTime?       @map("validite_fin") @db.Date
  complementaireId       String?         @map("complementaire_id")
  /// Devis et offre dont vient la demande. Instantané des lignes (Zod : `ligneDemandePecSchema`).
  devisId                String?         @map("devis_id")
  offre                  String?
  demande                Json?
  montantDemandeCentimes Int?            @map("montant_demande_centimes")
  /// Référence rendue par `PecGateway`.
  referencePlateforme    String?         @map("reference_plateforme")
  /// Clé opaque dans le DocumentStore. Le nom du fichier d'origine n'est pas conservé.
  justificatifCle        String?         @unique @map("justificatif_cle")
  justificatifType       String?         @map("justificatif_type")
  justificatifTaille     Int?            @map("justificatif_taille")
  saisieParId            String          @map("saisie_par_id")
  createdAt              DateTime        @default(now()) @map("created_at")
  updatedAt              DateTime        @updatedAt @map("updated_at")
  dossier                Dossier         @relation(fields: [dossierId], references: [id], onDelete: Restrict)
  complementaire         Complementaire? @relation(fields: [complementaireId], references: [id], onDelete: Restrict)
  devis                  Devis?          @relation(fields: [devisId], references: [id], onDelete: SetNull)
  saisiePar              Utilisateur     @relation(fields: [saisieParId], references: [id], onDelete: Restrict)
  organisation           Organisation    @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@index([organisationId])
  @@index([complementaireId])
  @@index([devisId])
  @@map("prise_en_charge")
}

// ---------------------------------------------------------------------------
// Tables techniques de Better Auth (noms de champs imposés par la bibliothèque)
// ---------------------------------------------------------------------------

model Session {
  id          String      @id @default(uuid(7))
  token       String      @unique
  expiresAt   DateTime    @map("expires_at")
  ipAddress   String?     @map("ip_address")
  userAgent   String?     @map("user_agent")
  userId      String      @map("utilisateur_id")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  utilisateur Utilisateur @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

/// Identifiants de connexion (ici uniquement « credential » : hash du mot de passe).
model Compte {
  id                    String      @id @default(uuid(7))
  accountId             String      @map("account_id")
  providerId            String      @map("provider_id")
  userId                String      @map("utilisateur_id")
  password              String?     @map("mot_de_passe_hash")
  accessToken           String?     @map("access_token")
  refreshToken          String?     @map("refresh_token")
  idToken               String?     @map("id_token")
  accessTokenExpiresAt  DateTime?   @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime?   @map("refresh_token_expires_at")
  scope                 String?
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")
  utilisateur           Utilisateur @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("compte")
}

model Verification {
  id         String   @id @default(uuid(7))
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verification")
}

/// Secret TOTP et codes de secours, chiffrés par Better Auth.
model DeuxFacteurs {
  id                      String      @id @default(uuid(7))
  secret                  String
  backupCodes             String      @map("codes_secours")
  userId                  String      @map("utilisateur_id")
  verified                Boolean     @default(true) @map("verifie")
  failedVerificationCount Int         @default(0) @map("echecs_verification")
  lockedUntil             DateTime?   @map("bloque_jusqu_a")
  utilisateur             Utilisateur @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@index([userId])
  @@map("deux_facteurs")
}

/// Compteurs de limitation de débit (connexion, 2FA).
model LimitationDebit {
  id          String @id @default(uuid(7))
  key         String @unique
  count       Int
  lastRequest BigInt @map("derniere_requete")

  @@map("limitation_debit")
}

// ---------------------------------------------------------------------------
// Journal d'audit
// ---------------------------------------------------------------------------

enum ActionAudit {
  READ
  CREATE
  UPDATE
  DELETE
  EXPORT
  PRINT
  SEND
  CONNEXION
  ECHEC_CONNEXION
  DECONNEXION
}

/// Journal d'audit, en ajout seul : UPDATE et DELETE sont refusés par un trigger (voir la migration).
/// Pas de clé étrangère hors organisation : une ligne survit à l'entité ou au compte qu'elle décrit.
/// Valeurs déjà masquées par le serveur (jamais de NIR ni de donnée de santé en clair).
model JournalAudit {
  id                 String      @id @default(uuid(7))
  horodatage         DateTime    @default(now())
  organisationId     String?     @map("organisation_id")
  /// Null pour un échec de connexion sur un compte inconnu.
  utilisateurId      String?     @map("utilisateur_id")
  /// Instantané « Prénom Nom <e-mail> » au moment de l'action, ou e-mail tenté à la connexion.
  utilisateurLibelle String      @map("utilisateur_libelle")
  role               Role?
  centreId           String?     @map("centre_id")
  action             ActionAudit
  /// Type d'entité (liste dans le domaine : TYPES_ENTITE).
  entiteType         String      @map("entite_type")
  entiteId           String?     @map("entite_id")
  /// Patient concerné (dossiers, devis… compris), pour le filtre « patient ».
  patientId          String?     @map("patient_id")
  /// Champs modifiés (valeurs hors liste blanche omises).
  champs             Json?
  /// Contexte : filtres d'un export, motif d'un échec de connexion…
  details            Json?

  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@index([organisationId, horodatage])
  @@index([utilisateurId, horodatage])
  @@index([patientId, horodatage])
  @@index([entiteType, entiteId])
  @@map("journal_audit")
}

// ---------------------------------------------------------------------------
// Agenda (ADR-020)
// ---------------------------------------------------------------------------

enum TypeExceptionAgenda {
  DISPONIBILITE
  INDISPONIBILITE
  CONGE
  FERMETURE_CENTRE
}

enum StatutRdv {
  PLANIFIE
  CONFIRME
  ARRIVE
  VU
  ABSENT
  ANNULE
}

enum OrigineRdv {
  INTERNE
  EN_LIGNE
  TELEPHONE
}

/// Salle insonorisée d'un centre. L'autre ressource de l'agenda est le praticien, qui suit ses centres.
model Cabine {
  id                  String               @id @default(uuid(7))
  organisationId      String               @default(dbgenerated("app_organisation_id()")) @map("organisation_id")
  centreId            String               @map("centre_id")
  nom                 String
  actif               Boolean              @default(true)
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  centre              Centre               @relation(fields: [centreId], references: [id], onDelete: Restrict)
  rendezVous          RendezVous[]
  exceptions          ExceptionAgenda[]
  organisation        Organisation         @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  reservationsEnLigne ReservationEnLigne[]

  @@unique([centreId, nom])
  @@index([organisationId])
  @@map("cabine")
}

/// Type de rendez-vous, par client. `natureEssai` relie le type à la trace d'essai correspondante (étape 13).
model TypeRdv {
  id                  String               @id @default(uuid(7))
  organisationId      String               @map("organisation_id")
  nom                 String
  dureeMinutes        Int                  @map("duree_minutes")
  couleur             String
  requierePraticien   Boolean              @map("requiere_praticien")
  requiereCabine      Boolean              @map("requiere_cabine")
  reservableEnLigne   Boolean              @default(false) @map("reservable_en_ligne")
  delaiMinimalMinutes Int                  @default(0) @map("delai_minimal_minutes")
  natureEssai         TypeRdvEssai?        @map("nature_essai")
  actif               Boolean              @default(true)
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  rendezVous          RendezVous[]
  organisation        Organisation         @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  centresEnLigne      TypeRdvEnLigne[]
  reservationsEnLigne ReservationEnLigne[]

  @@unique([organisationId, nom])
  @@map("type_rdv")
}

/// Écart aux horaires hebdomadaires. Pas de motif : un arrêt maladie serait une donnée de santé en clair.
model ExceptionAgenda {
  id             String              @id @default(uuid(7))
  organisationId String              @default(dbgenerated("app_organisation_id()")) @map("organisation_id")
  type           TypeExceptionAgenda
  praticienId    String?             @map("praticien_id")
  cabineId       String?             @map("cabine_id")
  centreId       String?             @map("centre_id")
  debut          DateTime            @db.Timestamptz(3)
  fin            DateTime            @db.Timestamptz(3)
  createdById    String              @map("created_by_id")
  createdAt      DateTime            @default(now()) @map("created_at")
  praticien      Praticien?          @relation(fields: [praticienId], references: [id], onDelete: Restrict)
  cabine         Cabine?             @relation(fields: [cabineId], references: [id], onDelete: Restrict)
  centre         Centre?             @relation(fields: [centreId], references: [id], onDelete: Restrict)
  createdBy      Utilisateur         @relation("ExceptionAgendaCreateur", fields: [createdById], references: [id], onDelete: Restrict)
  organisation   Organisation        @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@index([organisationId, debut])
  @@map("exception_agenda")
}

/// Rendez-vous. Deux contraintes d'exclusion, en SQL, interdisent la double réservation d'un praticien ou
/// d'une cabine. `arriveLe`, `priseEnChargeLe` et `termineLe` alimentent la salle d'attente.
model RendezVous {
  id                 String              @id @default(uuid(7))
  organisationId     String              @default(dbgenerated("app_organisation_id()")) @map("organisation_id")
  centreId           String              @map("centre_id")
  typeRdvId          String              @map("type_rdv_id")
  patientId          String?             @map("patient_id")
  /// Prospect : effacé à la conversion en patient.
  prospectNom        String?             @map("prospect_nom")
  prospectTelephone  String?             @map("prospect_telephone")
  /// Lien vers le dossier d'appareillage : un RDV d'essai tenu y reçoit son compte rendu (ADR-027).
  dossierId          String?             @map("dossier_id")
  praticienId        String?             @map("praticien_id")
  cabineId           String?             @map("cabine_id")
  debut              DateTime            @db.Timestamptz(3)
  fin                DateTime            @db.Timestamptz(3)
  statut             StatutRdv           @default(PLANIFIE)
  origine            OrigineRdv
  /// Chiffré (contexte « rendez_vous.notes ») : données de santé possibles.
  notes              String?
  arriveLe           DateTime?           @map("arrive_le") @db.Timestamptz(3)
  priseEnChargeLe    DateTime?           @map("prise_en_charge_le") @db.Timestamptz(3)
  termineLe          DateTime?           @map("termine_le") @db.Timestamptz(3)
  /// Verrou optimiste : toute écriture est conditionnée à la version lue, puis l'incrémente.
  version            Int                 @default(1)
  /// `null` : réservé en ligne par le patient, sans utilisateur (ADR-021).
  createdById        String?             @map("created_by_id")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  centre             Centre              @relation(fields: [centreId], references: [id], onDelete: Restrict)
  typeRdv            TypeRdv             @relation(fields: [typeRdvId], references: [id], onDelete: Restrict)
  patient            Patient?            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  dossier            Dossier?            @relation(fields: [dossierId], references: [id], onDelete: Restrict)
  praticien          Praticien?          @relation(fields: [praticienId], references: [id], onDelete: Restrict)
  cabine             Cabine?             @relation(fields: [cabineId], references: [id], onDelete: Restrict)
  createdBy          Utilisateur?        @relation("RendezVousCreateur", fields: [createdById], references: [id], onDelete: Restrict)
  organisation       Organisation        @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  reservationEnLigne ReservationEnLigne?
  essaiRdv           EssaiRdv?

  @@index([centreId, debut])
  @@index([patientId, debut])
  @@index([dossierId])
  @@index([organisationId])
  @@map("rendez_vous")
}

/// Outbox : écrite dans la transaction du métier, diffusée ensuite par `packages/jobs` (ADR-020).
/// La charge ne contient que des identifiants et des horaires.
model EvenementDomaine {
  id             String       @id @default(uuid(7))
  organisationId String       @default(dbgenerated("app_organisation_id()")) @map("organisation_id")
  type           String
  agregatId      String       @map("agregat_id")
  charge         Json
  survenuLe      DateTime     @map("survenu_le") @db.Timestamptz(3)
  diffuseLe      DateTime?    @map("diffuse_le") @db.Timestamptz(3)
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@index([organisationId])
  @@map("evenement_domaine")
}

enum ValidationReservation {
  AUTOMATIQUE
  MANUELLE
}

enum StatutReservation {
  VERROU
  FINALISEE
}

enum CanalNotification {
  SMS
  EMAIL
}

enum GabaritNotification {
  RDV_CONFIRME
  RDV_DEMANDE_RECUE
  RDV_ACCEPTE
  RDV_REFUSE
  RDV_DEPLACE
  RDV_ANNULE
  DOCUMENT_A_CONSULTER
  BON_COMMANDE
  RELANCE_COMMANDE
}

enum StatutNotification {
  A_ENVOYER
  ENVOYEE
  ABANDONNEE
}

/// Réservation en ligne d'un centre. Sans ligne ou inactive, la page publique répond 404.
model ParametresReservation {
  id                      String                @id @default(uuid(7))
  organisationId          String                @default(dbgenerated("app_organisation_id()")) @map("organisation_id")
  centreId                String                @unique @map("centre_id")
  actif                   Boolean               @default(false)
  delaiMinimalMinutes     Int                   @map("delai_minimal_minutes")
  horizonJours            Int                   @map("horizon_jours")
  validation              ValidationReservation
  /// Le patient annule ou déplace par son lien jusqu'à ce délai avant le rendez-vous.
  delaiModificationHeures Int                   @map("delai_modification_heures")
  createdAt               DateTime              @default(now()) @map("created_at")
  updatedAt               DateTime              @updatedAt @map("updated_at")
  centre                  Centre                @relation(fields: [centreId], references: [id], onDelete: Restrict)
  organisation            Organisation          @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@index([organisationId])
  @@map("parametres_reservation")
}

/// Types proposés en ligne par un centre, parmi ceux que le client déclare réservables.
model TypeRdvEnLigne {
  id             String       @id @default(uuid(7))
  organisationId String       @default(dbgenerated("app_organisation_id()")) @map("organisation_id")
  centreId       String       @map("centre_id")
  typeRdvId      String       @map("type_rdv_id")
  centre         Centre       @relation(fields: [centreId], references: [id], onDelete: Restrict)
  typeRdv        TypeRdv      @relation(fields: [typeRdvId], references: [id], onDelete: Restrict)
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@unique([centreId, typeRdvId])
  @@index([organisationId])
  @@map("type_rdv_en_ligne")
}

/// Parcours d'un patient, du verrou du créneau au rendez-vous. Tant que le statut est `VERROU`, deux contraintes
/// d'exclusion, en SQL, réservent le créneau face aux autres patients (ADR-021). L'identité s'efface dès qu'elle
/// a servi : au rapprochement d'une fiche, ou à la conversion du prospect.
model ReservationEnLigne {
  id                  String            @id @default(uuid(7))
  organisationId      String            @default(dbgenerated("app_organisation_id()")) @map("organisation_id")
  centreId            String            @map("centre_id")
  typeRdvId           String            @map("type_rdv_id")
  praticienId         String?           @map("praticien_id")
  cabineId            String?           @map("cabine_id")
  debut               DateTime          @db.Timestamptz(3)
  fin                 DateTime          @db.Timestamptz(3)
  statut              StatutReservation @default(VERROU)
  expireLe            DateTime          @map("expire_le") @db.Timestamptz(3)
  /// Empreinte du jeton de parcours, porté par le formulaire du navigateur.
  jetonEmpreinte      String            @unique @map("jeton_empreinte")
  nom                 String?
  prenom              String?
  dateNaissance       DateTime?         @map("date_naissance") @db.Date
  telephone           String?
  email               String?
  /// Chiffré (contexte « reservation_en_ligne.motif ») : données de santé possibles.
  motif               String?
  consentementRgpdLe  DateTime?         @map("consentement_rgpd_le") @db.Timestamptz(3)
  consentementSmsLe   DateTime?         @map("consentement_sms_le") @db.Timestamptz(3)
  versionConsentement String?           @map("version_consentement")
  /// Empreinte du code SMS, jamais le code.
  codeEmpreinte       String?           @map("code_empreinte")
  codeExpireLe        DateTime?         @map("code_expire_le") @db.Timestamptz(3)
  codeTentatives      Int               @default(0) @map("code_tentatives")
  codeEnvois          Int               @default(0) @map("code_envois")
  rendezVousId        String?           @unique @map("rendez_vous_id")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")
  centre              Centre            @relation(fields: [centreId], references: [id], onDelete: Restrict)
  typeRdv             TypeRdv           @relation(fields: [typeRdvId], references: [id], onDelete: Restrict)
  praticien           Praticien?        @relation(fields: [praticienId], references: [id], onDelete: Restrict)
  cabine              Cabine?           @relation(fields: [cabineId], references: [id], onDelete: Restrict)
  rendezVous          RendezVous?       @relation(fields: [rendezVousId], references: [id], onDelete: Restrict)
  organisation        Organisation      @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  notifications       Notification[]

  @@index([organisationId, statut, expireLe])
  @@index([centreId, debut])
  @@map("reservation_en_ligne")
}

/// Message à envoyer, écrit dans la transaction du métier et envoyé par `packages/jobs` (ADR-021) : au patient,
/// au prescripteur ou, pour une commande, au fournisseur avec le bon en pièce jointe (ADR-031).
/// Le code SMS n'y passe jamais.
model Notification {
  id              String              @id @default(uuid(7))
  organisationId  String              @default(dbgenerated("app_organisation_id()")) @map("organisation_id")
  /// Exactement une source : la réservation, le lien vers un document ou la commande (contrainte CHECK).
  reservationId   String?             @map("reservation_id")
  lienDocumentId  String?             @map("lien_document_id")
  commandeId      String?             @map("commande_id")
  canal           CanalNotification
  /// Chiffré (contexte « notification.destinataire »).
  destinataire    String
  gabarit         GabaritNotification
  /// Validés par `parametresGabaritSchema` : ni type de rendez-vous, ni motif, ni nom.
  parametres      Json
  cleIdempotence  String              @map("cle_idempotence")
  statut          StatutNotification  @default(A_ENVOYER)
  tentatives      Int                 @default(0)
  prochainEssaiLe DateTime            @default(now()) @map("prochain_essai_le") @db.Timestamptz(3)
  envoyeeLe       DateTime?           @map("envoyee_le") @db.Timestamptz(3)
  createdAt       DateTime            @default(now()) @map("created_at")
  reservation     ReservationEnLigne? @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  lienDocument    LienDocument?       @relation(fields: [lienDocumentId], references: [id], onDelete: Restrict)
  commande        Commande?           @relation(fields: [commandeId], references: [id], onDelete: Restrict)
  organisation    Organisation        @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@unique([organisationId, cleIdempotence])
  @@index([reservationId])
  @@index([lienDocumentId])
  @@index([commandeId])
  @@map("notification")
}

enum CibleLienDocument {
  DEVIS
  COMPTE_RENDU_ESSAI
  FACTURE
}

enum DestinataireLien {
  PATIENT
  PRESCRIPTEUR
}

/// Lien à durée limitée vers un document (ADR-026). Le jeton n'est pas stocké : il se recalcule depuis `id`.
model LienDocument {
  id                  String            @id @default(uuid(7))
  organisationId      String            @default(dbgenerated("app_organisation_id()")) @map("organisation_id")
  /// Nul sur la facture d'une vente directe.
  dossierId           String?           @map("dossier_id")
  /// Patient dont la date de naissance ouvre le lien.
  patientId           String            @map("patient_id")
  /// Renseigné pour la cible FACTURE seulement.
  factureId           String?           @map("facture_id")
  cible               CibleLienDocument
  destinataire        DestinataireLien
  /// Clé opaque dans le DocumentStore : le PDF du devis, ou le compte rendu figé à l'envoi.
  pdfCle              String            @map("pdf_cle")
  expireLe            DateTime          @map("expire_le") @db.Timestamptz(3)
  revoqueLe           DateTime?         @map("revoque_le") @db.Timestamptz(3)
  /// Dates de naissance erronées ; à 5, `bloqueLe` ferme le lien.
  tentatives          Int               @default(0)
  bloqueLe            DateTime?         @map("bloque_le") @db.Timestamptz(3)
  ouvertures          Int               @default(0)
  derniereOuvertureLe DateTime?         @map("derniere_ouverture_le") @db.Timestamptz(3)
  /// Compte rendu figé retiré du stockage une fois le lien expiré.
  pdfPurgeLe          DateTime?         @map("pdf_purge_le") @db.Timestamptz(3)
  createdById         String            @map("created_by_id")
  createdAt           DateTime          @default(now()) @map("created_at")
  organisation        Organisation      @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  dossier             Dossier?          @relation(fields: [dossierId], references: [id], onDelete: Restrict)
  patient             Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  facture             Facture?          @relation(fields: [factureId], references: [id], onDelete: Restrict)
  createdBy           Utilisateur       @relation(fields: [createdById], references: [id], onDelete: Restrict)
  notifications       Notification[]

  @@index([dossierId, createdAt])
  @@index([patientId])
  @@index([factureId])
  @@index([cible, expireLe])
  @@index([organisationId])
  @@map("lien_document")
}

// ---------------------------------------------------------------------------
// Dossier audiologique (ADR-022)
// Les données cliniques sont chiffrées : du JSON sérialisé en texte, jamais une colonne `Json`.
// Tout se lit directement, jamais par relation imbriquée.

enum SourceMesure {
  SAISIE
  NOAH
}

enum TypeMesure {
  TONALE
  VOCALE_CALME
  VOCALE_BRUIT
}

enum NatureFormulaire {
  ANAMNESE
  BENEFICE
  SATISFACTION
}

/// Une séance. Sans lien obligatoire vers `Dossier` : le bilan précède le dossier d'appareillage.
model BilanAudiologique {
  id             String               @id @default(uuid(7))
  organisationId String               @default(dbgenerated("app_organisation_id()")) @map("organisation_id")
  patientId      String               @map("patient_id")
  centreId       String               @map("centre_id")
  praticienId    String?              @map("praticien_id")
  dateBilan      DateTime             @map("date_bilan") @db.Date
  createdById    String               @map("created_by_id")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  organisation   Organisation         @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  patient        Patient              @relation(fields: [patientId], references: [id], onDelete: Restrict)
  centre         Centre               @relation(fields: [centreId], references: [id], onDelete: Restrict)
  praticien      Praticien?           @relation(fields: [praticienId], references: [id], onDelete: Restrict)
  createdBy      Utilisateur          @relation(fields: [createdById], references: [id], onDelete: Restrict)
  mesures        MesureAudiologique[]
  otoscopies     Otoscopie[]
  reponses       ReponseFormulaire[]
  dossiers       Dossier[]

  @@index([patientId, dateBilan])
  @@index([organisationId])
  @@index([centreId])
  @@map("bilan_audiologique")
}

/// Une seule mesure SAISIE par type et par bilan ; une mesure NOAH s'importe une fois par identifiant
/// externe (index partiels de la migration). Une mesure NOAH ne se modifie pas.
model MesureAudiologique {
  id                 String            @id @default(uuid(7))
  organisationId     String            @default(dbgenerated("app_organisation_id()")) @map("organisation_id")
  bilanId            String            @map("bilan_id")
  type               TypeMesure
  source             SourceMesure      @default(SAISIE)
  mesureLe           DateTime          @map("mesure_le")
  /// Audiomètre utilisé, texte libre sans donnée de santé.
  appareil           String?
  /// Renseigné si et seulement si `source = NOAH` (contrainte CHECK).
  identifiantExterne String?           @map("identifiant_externe")
  importeLe          DateTime?         @map("importe_le")
  /// Chiffré (contexte « mesure_audiologique.donnees ») : JSON des seuils ou des courbes.
  donnees            String
  versionSchema      Int               @map("version_schema")
  /// `null` : mesure importée.
  auteurId           String?           @map("auteur_id")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  organisation       Organisation      @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  bilan              BilanAudiologique @relation(fields: [bilanId], references: [id], onDelete: Restrict)
  auteur             Utilisateur?      @relation(fields: [auteurId], references: [id], onDelete: Restrict)

  @@index([bilanId])
  @@index([organisationId])
  @@map("mesure_audiologique")
}

model Otoscopie {
  id             String            @id @default(uuid(7))
  organisationId String            @default(dbgenerated("app_organisation_id()")) @map("organisation_id")
  bilanId        String            @map("bilan_id")
  oreille        Oreille
  source         SourceMesure      @default(SAISIE)
  /// Chiffré (contexte « otoscopie.constat ») : JSON du constat.
  constat        String
  /// Clé opaque dans le DocumentStore. Les trois champs vont ensemble (contrainte CHECK).
  photoCle       String?           @unique @map("photo_cle")
  photoType      String?           @map("photo_type")
  photoTaille    Int?              @map("photo_taille")
  auteurId       String?           @map("auteur_id")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  organisation   Organisation      @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  bilan          BilanAudiologique @relation(fields: [bilanId], references: [id], onDelete: Restrict)
  auteur         Utilisateur?      @relation(fields: [auteurId], references: [id], onDelete: Restrict)

  @@unique([bilanId, oreille])
  @@index([organisationId])
  @@map("otoscopie")
}

/// Une version est immuable : `ha_app` ne peut modifier que `actif`. Modifier un modèle crée une version.
model ModeleFormulaire {
  id             String              @id @default(uuid(7))
  organisationId String              @default(dbgenerated("app_organisation_id()")) @map("organisation_id")
  code           String
  version        Int
  nature         NatureFormulaire
  nom            String
  /// Structure sans donnée patient, en clair. Validée par `definitionFormulaireSchema`.
  definition     Json
  actif          Boolean             @default(true)
  createdById    String?             @map("created_by_id")
  createdAt      DateTime            @default(now()) @map("created_at")
  organisation   Organisation        @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  createdBy      Utilisateur?        @relation(fields: [createdById], references: [id], onDelete: Restrict)
  reponses       ReponseFormulaire[]

  @@unique([organisationId, code, version])
  @@index([organisationId, nature])
  @@map("modele_formulaire")
}

/// Une seule anamnèse par bilan (index partiel de la migration).
model ReponseFormulaire {
  id             String            @id @default(uuid(7))
  organisationId String            @default(dbgenerated("app_organisation_id()")) @map("organisation_id")
  bilanId        String            @map("bilan_id")
  modeleId       String            @map("modele_id")
  nature         NatureFormulaire
  /// Chiffré (contexte « reponse_formulaire.reponses ») : JSON des réponses.
  reponses       String
  auteurId       String            @map("auteur_id")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  organisation   Organisation      @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  bilan          BilanAudiologique @relation(fields: [bilanId], references: [id], onDelete: Restrict)
  modele         ModeleFormulaire  @relation(fields: [modeleId], references: [id], onDelete: Restrict)
  auteur         Utilisateur       @relation(fields: [auteurId], references: [id], onDelete: Restrict)

  @@unique([bilanId, modeleId])
  @@index([organisationId])
  @@index([modeleId])
  @@map("reponse_formulaire")
}

// ---------------------------------------------------------------------------
// Tiers payant
// ---------------------------------------------------------------------------

enum ModePec {
  PORTAIL
  EDI
}

enum TypeCreance {
  AMO
  AMC
}

enum OrigineReglement {
  MANUEL
  NOEMIE
}

enum NatureRegularisation {
  ECART_PERTE
  ECART_PROFIT
  TRANSFERT_PATIENT
}

enum ResolutionRejet {
  REPRESENTEE
  TRANSFEREE_PATIENT
  ABANDONNEE
}

/// Référentiel des complémentaires d'un client.
model Complementaire {
  id                    String               @id @default(uuid(7))
  organisationId        String               @default(dbgenerated("app_organisation_id()")) @map("organisation_id")
  nom                   String
  identifiant           String
  plateformeTiersPayant String?              @map("plateforme_tiers_payant")
  telephone             String?
  email                 String?
  adresse               String?
  modePec               ModePec              @default(PORTAIL) @map("mode_pec")
  /// Délai attendu entre la facture et le paiement. À VÉRIFIER (R42).
  delaiPaiementJours    Int                  @default(30) @map("delai_paiement_jours")
  actif                 Boolean              @default(true)
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")
  organisation          Organisation         @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  prisesEnCharge        PriseEnCharge[]
  creances              Creance[]
  reglements            ReglementOrganisme[]

  @@unique([organisationId, identifiant])
  @@map("complementaire")
}

/// Ce qu'un organisme doit sur une facture, une ligne par part. Seuls le solde, l'échéance et la relance évoluent.
model Creance {
  id                String                  @id @default(uuid(7))
  organisationId    String                  @default(dbgenerated("app_organisation_id()")) @map("organisation_id")
  centreId          String                  @map("centre_id")
  factureId         String                  @map("facture_id")
  patientId         String                  @map("patient_id")
  type              TypeCreance
  complementaireId  String?                 @map("complementaire_id")
  /// Libellé figé à la validation : caisse ou complémentaire.
  organisme         String
  regime            String?
  numeroAccord      String?                 @map("numero_accord")
  montantCentimes   Int                     @map("montant_centimes")
  /// Écrit par le service sous le verrou de chaîne (ADR-030) ; négatif s'il reste un indu.
  soldeCentimes     Int                     @map("solde_centimes")
  dateEmission      DateTime                @map("date_emission") @db.Date
  echeanceAttendue  DateTime                @map("echeance_attendue") @db.Date
  derniereRelanceLe DateTime?               @map("derniere_relance_le") @db.Date
  createdAt         DateTime                @default(now()) @map("created_at")
  organisation      Organisation            @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  centre            Centre                  @relation(fields: [centreId], references: [id], onDelete: Restrict)
  facture           Facture                 @relation(fields: [factureId], references: [id], onDelete: Restrict)
  patient           Patient                 @relation(fields: [patientId], references: [id], onDelete: Restrict)
  complementaire    Complementaire?         @relation(fields: [complementaireId], references: [id], onDelete: Restrict)
  lettrages         Lettrage[]
  regularisations   RegularisationCreance[]
  rejets            RejetCreance[]

  @@unique([factureId, type])
  @@index([organisationId])
  @@index([centreId, soldeCentimes])
  @@index([centreId, organisme])
  @@index([patientId])
  @@index([complementaireId])
  @@map("creance")
}

/// Virement reçu d'un organisme, chaîné. Ajout seul, sauf `resteALettrerCentimes` ; une annulation est une ligne inverse.
model ReglementOrganisme {
  id                    String                  @id
  organisationId        String                  @map("organisation_id")
  centreId              String                  @map("centre_id")
  organisme             String
  complementaireId      String?                 @map("complementaire_id")
  dateReglement         DateTime                @map("date_reglement") @db.Date
  /// En clair : référence du virement, sans donnée patient. Elle sert au rapprochement (art. 37).
  reference             String
  /// Négatives sur une annulation.
  partAmoCentimes       Int                     @map("part_amo_centimes")
  partAmcCentimes       Int                     @map("part_amc_centimes")
  resteALettrerCentimes Int                     @map("reste_a_lettrer_centimes")
  origine               OrigineReglement        @default(MANUEL)
  /// Identifiant du retour NOEMIE, pour importer deux fois sans doublon (étape 26).
  identifiantExterne    String?                 @map("identifiant_externe")
  origineId             String?                 @map("origine_id")
  /// Chiffré : saisie libre.
  motif                 String?
  rang                  Int
  empreinte             String                  @db.Char(64)
  acteurId              String                  @map("acteur_id")
  createdAt             DateTime                @map("created_at") @db.Timestamptz(3)
  organisation          Organisation            @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  centre                Centre                  @relation(fields: [centreId], references: [id], onDelete: Restrict)
  complementaire        Complementaire?         @relation(fields: [complementaireId], references: [id], onDelete: Restrict)
  origineReglement      ReglementOrganisme?     @relation("ReglementInverse", fields: [origineId], references: [id], onDelete: Restrict)
  inverses              ReglementOrganisme[]    @relation("ReglementInverse")
  acteur                Utilisateur             @relation(fields: [acteurId], references: [id], onDelete: Restrict)
  lettrages             Lettrage[]
  regularisations       RegularisationCreance[]

  @@unique([centreId, rang])
  @@unique([centreId, identifiantExterne])
  @@index([organisationId])
  @@index([centreId, resteALettrerCentimes])
  @@index([centreId, organisme, reference])
  @@index([complementaireId])
  @@index([origineId])
  @@map("reglement_organisme")
}

/// Appariement d'un règlement et d'une créance. Sans effet comptable, ajout seul : un délettrage est une ligne inverse.
model Lettrage {
  id              String             @id @default(uuid(7))
  organisationId  String             @default(dbgenerated("app_organisation_id()")) @map("organisation_id")
  centreId        String             @map("centre_id")
  reglementId     String             @map("reglement_id")
  creanceId       String             @map("creance_id")
  type            TypeCreance
  /// Négatif sur un délettrage.
  montantCentimes Int                @map("montant_centimes")
  origineId       String?            @map("origine_id")
  acteurId        String             @map("acteur_id")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  organisation    Organisation       @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  centre          Centre             @relation(fields: [centreId], references: [id], onDelete: Restrict)
  reglement       ReglementOrganisme @relation(fields: [reglementId], references: [id], onDelete: Restrict)
  creance         Creance            @relation(fields: [creanceId], references: [id], onDelete: Restrict)
  origineLettrage Lettrage?          @relation("LettrageInverse", fields: [origineId], references: [id], onDelete: Restrict)
  inverses        Lettrage[]         @relation("LettrageInverse")
  acteur          Utilisateur        @relation(fields: [acteurId], references: [id], onDelete: Restrict)

  @@index([organisationId])
  @@index([reglementId])
  @@index([creanceId])
  @@index([origineId])
  @@map("lettrage")
}

/// Écart ou transfert au patient, chaîné. Ajout seul ; une contre-passation est une ligne de montant négatif.
model RegularisationCreance {
  id              String                  @id
  organisationId  String                  @map("organisation_id")
  centreId        String                  @map("centre_id")
  creanceId       String?                 @map("creance_id")
  reglementId     String?                 @map("reglement_id")
  type            TypeCreance
  nature          NatureRegularisation
  montantCentimes Int                     @map("montant_centimes")
  /// Chiffré : saisie libre.
  motif           String
  origineId       String?                 @map("origine_id")
  rang            Int
  empreinte       String                  @db.Char(64)
  acteurId        String                  @map("acteur_id")
  createdAt       DateTime                @map("created_at") @db.Timestamptz(3)
  organisation    Organisation            @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  centre          Centre                  @relation(fields: [centreId], references: [id], onDelete: Restrict)
  creance         Creance?                @relation(fields: [creanceId], references: [id], onDelete: Restrict)
  reglement       ReglementOrganisme?     @relation(fields: [reglementId], references: [id], onDelete: Restrict)
  origineLigne    RegularisationCreance?  @relation("RegularisationInverse", fields: [origineId], references: [id], onDelete: Restrict)
  inverses        RegularisationCreance[] @relation("RegularisationInverse")
  acteur          Utilisateur             @relation(fields: [acteurId], references: [id], onDelete: Restrict)

  @@unique([centreId, rang])
  @@index([organisationId])
  @@index([creanceId])
  @@index([reglementId])
  @@index([origineId])
  @@map("regularisation_creance")
}

/// Rejet d'un organisme sur une créance. `resolution` vide : à traiter.
model RejetCreance {
  id             String           @id @default(uuid(7))
  organisationId String           @default(dbgenerated("app_organisation_id()")) @map("organisation_id")
  centreId       String           @map("centre_id")
  creanceId      String           @map("creance_id")
  dateRejet      DateTime         @map("date_rejet") @db.Date
  /// Code de l'organisme, à aligner sur NOEMIE à l'étape 26.
  code           String?
  /// Chiffré : saisie libre.
  motif          String
  resolution     ResolutionRejet?
  resoluLe       DateTime?        @map("resolu_le") @db.Timestamptz(3)
  resoluParId    String?          @map("resolu_par_id")
  saisiParId     String           @map("saisi_par_id")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  centre         Centre           @relation(fields: [centreId], references: [id], onDelete: Restrict)
  creance        Creance          @relation(fields: [creanceId], references: [id], onDelete: Restrict)
  saisiPar       Utilisateur      @relation("RejetSaisi", fields: [saisiParId], references: [id], onDelete: Restrict)
  resoluPar      Utilisateur?     @relation("RejetResolu", fields: [resoluParId], references: [id], onDelete: Restrict)

  @@index([organisationId])
  @@index([creanceId])
  @@index([centreId, resolution])
  @@map("rejet_creance")
}
