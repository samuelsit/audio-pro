generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Métadonnées techniques (version du schéma, date du seed). Aucune donnée métier.
model AppMeta {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_meta")
}

// ---------------------------------------------------------------------------
// Réseau, centres, utilisateurs, praticiens
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  AUDIO
  ASSISTANT
}

/// Le réseau de centres (une seule ligne en pratique).
model Organisation {
  id           String        @id @default(uuid(7))
  nom          String
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  centres      Centre[]
  utilisateurs Utilisateur[]
  patients     Patient[]

  @@map("organisation")
}

/// Centre (établissement). On ne supprime pas un centre : on le désactive.
model Centre {
  id                  String              @id @default(uuid(7))
  organisationId      String              @map("organisation_id")
  nom                 String
  adresseLigne1       String              @map("adresse_ligne1")
  adresseLigne2       String?             @map("adresse_ligne2")
  codePostal          String              @map("code_postal")
  ville               String
  finess              String?             @unique
  /// Identifiant de facturation Assurance Maladie, attribué par établissement.
  numeroFacturationAm String?             @unique @map("numero_facturation_am")
  email               String
  telephone           String
  actif               Boolean             @default(true)
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  organisation        Organisation        @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  utilisateurs        UtilisateurCentre[]
  praticiens          PraticienCentre[]
  patients            Patient[]

  @@unique([organisationId, nom])
  @@map("centre")
}

/// Compte utilisateur. Table « user » de Better Auth (noms de champs imposés : name, email,
/// emailVerified, image, twoFactorEnabled), complétée par nos champs métier.
model Utilisateur {
  id                    String              @id @default(uuid(7))
  organisationId        String              @map("organisation_id")
  prenom                String
  nom                   String
  /// Nom affiché exigé par Better Auth (« Prénom Nom »), maintenu par le service.
  name                  String              @map("nom_affiche")
  /// Toujours en minuscules.
  email                 String              @unique
  emailVerified         Boolean             @default(false) @map("email_verifie")
  image                 String?
  role                  Role
  actif                 Boolean             @default(true)
  doitChangerMotDePasse Boolean             @default(true) @map("doit_changer_mot_de_passe")
  /// 2FA TOTP : obligatoire pour ADMIN, facultative pour les autres rôles.
  twoFactorEnabled      Boolean             @default(false) @map("deux_facteurs_actif")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")
  organisation          Organisation        @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  centres               UtilisateurCentre[]
  praticien             Praticien?
  sessions              Session[]
  comptes               Compte[]
  deuxFacteurs          DeuxFacteurs[]

  @@index([organisationId])
  @@map("utilisateur")
}

/// Rattachement d'un utilisateur à un centre. Un ADMIN accède à tous les centres sans rattachement.
model UtilisateurCentre {
  utilisateurId String      @map("utilisateur_id")
  centreId      String      @map("centre_id")
  createdAt     DateTime    @default(now()) @map("created_at")
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  centre        Centre      @relation(fields: [centreId], references: [id], onDelete: Restrict)

  @@id([utilisateurId, centreId])
  @@index([centreId])
  @@map("utilisateur_centre")
}

/// Audioprothésiste : fiche liée à un utilisateur de rôle AUDIO (contrôlé par le service).
model Praticien {
  id            String            @id @default(uuid(7))
  utilisateurId String            @unique @map("utilisateur_id")
  rpps          String            @unique @db.Char(11)
  adeli         String?           @unique @db.Char(9)
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  utilisateur   Utilisateur       @relation(fields: [utilisateurId], references: [id], onDelete: Restrict)
  centres       PraticienCentre[]

  @@map("praticien")
}

/// Centre d'exercice d'un praticien (sous-ensemble des rattachements de son utilisateur).
model PraticienCentre {
  praticienId String    @map("praticien_id")
  centreId    String    @map("centre_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  praticien   Praticien @relation(fields: [praticienId], references: [id], onDelete: Cascade)
  centre      Centre    @relation(fields: [centreId], references: [id], onDelete: Restrict)

  @@id([praticienId, centreId])
  @@index([centreId])
  @@map("praticien_centre")
}

// ---------------------------------------------------------------------------
// Patients
// ---------------------------------------------------------------------------

enum Civilite {
  M
  MME
}

enum Sexe {
  MASCULIN
  FEMININ
}

enum QualiteBeneficiaire {
  ASSURE
  AYANT_DROIT
}

enum OrigineDonnee {
  SAISIE
  VITALE
}

/// Fiche patient, visible des utilisateurs qui ont accès à son centre de rattachement.
/// Une fiche fusionnée n'est pas supprimée : elle pointe vers la fiche conservée (`fusionneDansId`).
/// Les couvertures sont lues et écrites directement (jamais par relation imbriquée : champs chiffrés).
model Patient {
  id                    String         @id @default(uuid(7))
  organisationId        String         @map("organisation_id")
  centreId              String         @map("centre_id")
  civilite              Civilite
  nomNaissance          String         @map("nom_naissance")
  nomUsage              String?        @map("nom_usage")
  prenoms               String
  dateNaissance         DateTime       @map("date_naissance") @db.Date
  sexe                  Sexe
  adresseLigne1         String?        @map("adresse_ligne1")
  adresseLigne2         String?        @map("adresse_ligne2")
  codePostal            String?        @map("code_postal")
  ville                 String?
  telephone             String?
  email                 String?
  /// Texte libre pendant le MVP.
  medecinTraitant       String?        @map("medecin_traitant")
  consentementSms       Boolean        @default(false) @map("consentement_sms")
  consentementEmail     Boolean        @default(false) @map("consentement_email")
  consentementCourrier  Boolean        @default(false) @map("consentement_courrier")
  /// Chiffré (contexte « patient.notes ») : peut contenir des données de santé.
  notes                 String?
  /// Formes normalisées (sans accents, majuscules) pour la recherche et les doublons.
  nomNaissanceRecherche String         @map("nom_naissance_recherche")
  nomUsageRecherche     String?        @map("nom_usage_recherche")
  prenomsRecherche      String         @map("prenoms_recherche")
  fusionneDansId        String?        @map("fusionne_dans_id")
  fusionneLe            DateTime?      @map("fusionne_le")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")
  organisation          Organisation   @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  centre                Centre         @relation(fields: [centreId], references: [id], onDelete: Restrict)
  fusionneDans          Patient?       @relation("FusionPatient", fields: [fusionneDansId], references: [id], onDelete: Restrict)
  fusionnes             Patient[]      @relation("FusionPatient")
  couvertureAmo         CouvertureAmo?
  couvertureAmc         CouvertureAmc?

  @@index([organisationId, nomNaissanceRecherche])
  @@index([organisationId, nomUsageRecherche])
  @@index([organisationId, dateNaissance])
  @@index([centreId])
  @@map("patient")
}

/// Couverture assurance maladie obligatoire (une par patient).
model CouvertureAmo {
  id                    String              @id @default(uuid(7))
  patientId             String              @unique @map("patient_id")
  /// NIR complet (15 caractères), chiffré (contexte « couverture_amo.nir »).
  nir                   String
  /// HMAC-SHA256 des 13 premiers caractères : recherche exacte et doublons. Non unique (ayants droit).
  nirEmpreinte          String              @map("nir_empreinte") @db.Char(64)
  rangNaissance         Int                 @map("rang_naissance")
  qualite               QualiteBeneficiaire
  regime                String?
  caisse                String?
  centreGestionnaire    String?             @map("centre_gestionnaire")
  finDroits             DateTime?           @map("fin_droits") @db.Date
  c2s                   Boolean             @default(false)
  /// Indicateur ALD (donnée de santé), chiffré (contexte « couverture_amo.ald ») : « OUI » ou « NON ».
  ald                   String
  origine               OrigineDonnee
  derniereLectureVitale DateTime?           @map("derniere_lecture_vitale")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")
  patient               Patient             @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([nirEmpreinte])
  @@map("couverture_amo")
}

/// Couverture complémentaire (une par patient pendant le MVP).
model CouvertureAmc {
  id                   String    @id @default(uuid(7))
  patientId            String    @unique @map("patient_id")
  organismeNom         String    @map("organisme_nom")
  organismeIdentifiant String?   @map("organisme_identifiant")
  numeroAdherent       String?   @map("numero_adherent")
  typeContrat          String?   @map("type_contrat")
  debutValidite        DateTime? @map("debut_validite") @db.Date
  finValidite          DateTime? @map("fin_validite") @db.Date
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  patient              Patient   @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@map("couverture_amc")
}

// ---------------------------------------------------------------------------
// Tables techniques de Better Auth (noms de champs imposés par la bibliothèque)
// ---------------------------------------------------------------------------

model Session {
  id          String      @id @default(uuid(7))
  token       String      @unique
  expiresAt   DateTime    @map("expires_at")
  ipAddress   String?     @map("ip_address")
  userAgent   String?     @map("user_agent")
  userId      String      @map("utilisateur_id")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  utilisateur Utilisateur @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

/// Identifiants de connexion (ici uniquement « credential » : hash du mot de passe).
model Compte {
  id                    String      @id @default(uuid(7))
  accountId             String      @map("account_id")
  providerId            String      @map("provider_id")
  userId                String      @map("utilisateur_id")
  password              String?     @map("mot_de_passe_hash")
  accessToken           String?     @map("access_token")
  refreshToken          String?     @map("refresh_token")
  idToken               String?     @map("id_token")
  accessTokenExpiresAt  DateTime?   @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime?   @map("refresh_token_expires_at")
  scope                 String?
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")
  utilisateur           Utilisateur @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("compte")
}

model Verification {
  id         String   @id @default(uuid(7))
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verification")
}

/// Secret TOTP et codes de secours, chiffrés par Better Auth.
model DeuxFacteurs {
  id                      String      @id @default(uuid(7))
  secret                  String
  backupCodes             String      @map("codes_secours")
  userId                  String      @map("utilisateur_id")
  verified                Boolean     @default(true) @map("verifie")
  failedVerificationCount Int         @default(0) @map("echecs_verification")
  lockedUntil             DateTime?   @map("bloque_jusqu_a")
  utilisateur             Utilisateur @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@index([userId])
  @@map("deux_facteurs")
}

/// Compteurs de limitation de débit (connexion, 2FA).
model LimitationDebit {
  id          String @id @default(uuid(7))
  key         String @unique
  count       Int
  lastRequest BigInt @map("derniere_requete")

  @@map("limitation_debit")
}

// ---------------------------------------------------------------------------
// Journal d'audit
// ---------------------------------------------------------------------------

enum ActionAudit {
  READ
  CREATE
  UPDATE
  DELETE
  EXPORT
  PRINT
  CONNEXION
  ECHEC_CONNEXION
  DECONNEXION
}

/// Journal d'audit, en ajout seul : UPDATE et DELETE sont refusés par un trigger (voir la migration).
/// Aucune clé étrangère : une ligne survit à l'entité ou au compte qu'elle décrit.
/// Valeurs déjà masquées par le serveur (jamais de NIR ni de donnée de santé en clair).
model JournalAudit {
  id                 String      @id @default(uuid(7))
  horodatage         DateTime    @default(now())
  organisationId     String?     @map("organisation_id")
  /// Null pour un échec de connexion sur un compte inconnu.
  utilisateurId      String?     @map("utilisateur_id")
  /// Instantané « Prénom Nom <e-mail> » au moment de l'action, ou e-mail tenté à la connexion.
  utilisateurLibelle String      @map("utilisateur_libelle")
  role               Role?
  centreId           String?     @map("centre_id")
  action             ActionAudit
  /// Type d'entité (liste dans le domaine : TYPES_ENTITE).
  entiteType         String      @map("entite_type")
  entiteId           String?     @map("entite_id")
  /// Patient concerné (dossiers, devis… compris), pour le filtre « patient ».
  patientId          String?     @map("patient_id")
  /// Champs modifiés (valeurs hors liste blanche omises).
  champs             Json?
  /// Contexte : filtres d'un export, motif d'un échec de connexion…
  details            Json?

  @@index([organisationId, horodatage])
  @@index([utilisateurId, horodatage])
  @@index([patientId, horodatage])
  @@index([entiteType, entiteId])
  @@map("journal_audit")
}
